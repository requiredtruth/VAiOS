    "index.html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover\">\n<title>URL to VAiOS Builder</title>\n<style>\n:root{--bg:#020604;--panel:#06180d;--panel2:#0a2414;--line:#2d6841;--line2:#86efac;--text:#eafff0;--muted:#a4d4af;--accent:#22c55e;--bad:#ef4444;--warn:#eab308;--shadow:0 16px 40px rgba(0,0,0,.45)}\n*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:linear-gradient(135deg,#020604,#062514);color:var(--text);font-family:Tahoma,system-ui,-apple-system,Segoe UI,Roboto,sans-serif}button,input,select,textarea{font:inherit;color:var(--text);min-width:0}button{border:2px solid #244a34;border-top-color:#a7f3b7;border-left-color:#a7f3b7;border-right-color:#020604;border-bottom-color:#020604;background:#14532d;padding:9px 11px;font-weight:900;border-radius:10px;cursor:pointer}button:hover{filter:brightness(1.12)}button:active{transform:translateY(1px);border-color:#020604 #a7f3b7 #a7f3b7 #020604}.primary{background:#15803d}.bad{background:#7f1d1d}.warn{background:#854d0e}.ghost{background:#07180d}.small{font-size:12px;padding:5px 8px}input,select,textarea{width:100%;background:#031008;border:2px inset #2c6240;border-radius:8px;padding:8px;outline:none}textarea{min-height:84px;resize:vertical;user-select:text}.wrap{height:100vh;display:grid;grid-template-rows:auto 1fr}.top{display:flex;gap:10px;align-items:center;padding:10px 12px;border-bottom:2px solid var(--line2);background:#063819;box-shadow:var(--shadow);z-index:2}.logo{width:38px;height:38px;border:2px solid #bbf7d0;border-radius:10px;display:grid;place-items:center;background:#052e16;font-size:23px}.top h1{font-size:18px;margin:0}.top p{font-size:12px;color:#b7e7c2;margin:2px 0 0}.main{min-height:0;display:grid;grid-template-columns:minmax(300px,430px) minmax(0,1fr);gap:10px;padding:10px}.panel{min-height:0;background:rgba(3,16,8,.90);border:2px solid var(--line);box-shadow:var(--shadow);border-radius:12px;overflow:auto}.side{padding:10px}.card{border:1px solid #255638;background:#06180d;padding:10px;border-radius:10px;margin-bottom:10px}.card h2,.card h3{margin:0 0 8px;font-size:15px}.grid{display:grid;gap:8px}.two{grid-template-columns:1fr 1fr}.row{display:flex;gap:7px;align-items:center;flex-wrap:wrap}.grow{flex:1}.muted{color:var(--muted)}.tiny{font-size:11px}.label{font-size:11px;color:#bdf4cb;font-weight:900;text-transform:uppercase;letter-spacing:.07em;margin:8px 0 5px}.status{white-space:pre-wrap;user-select:text;overflow-wrap:anywhere;background:#020d06;border:2px inset #255638;border-radius:9px;padding:8px;min-height:70px}.previewPanel{display:grid;grid-template-rows:auto 1fr}.previewBar{display:flex;align-items:center;gap:7px;padding:8px;background:#041109;border-bottom:2px solid #255638}.previewBar strong{font-size:13px}.previewFrameWrap{min-height:0;background:#111;position:relative}.preview{width:100%;height:100%;border:0;background:#fff;display:block}.empty{position:absolute;inset:0;display:grid;place-items:center;text-align:center;background:linear-gradient(135deg,#020604,#041b0c);pointer-events:none}.pill{display:inline-flex;align-items:center;max-width:60%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;border:1px solid #255638;border-radius:999px;padding:3px 8px;color:#bdf4cb;background:#031008}.warnbox{border-color:#715b13;background:#1d1603}.ok{color:#86efac}.err{color:#fca5a5}.mono{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace}.fallback{min-height:160px;font-size:11px}.btnFlash{outline:2px solid #86efac;outline-offset:2px}\n@media(max-width:820px){.main{grid-template-columns:1fr;overflow:auto}.wrap{overflow:auto}.panel{overflow:visible}.previewPanel{height:70vh}.top h1{font-size:15px}}\n</style>\n</head>\n<body>\n<div class=\"wrap\">\n  <div class=\"top\">\n    <div class=\"logo\">🌐</div>\n    <div class=\"grow\"><h1>URL → VAiOS Builder</h1><p>Turn any iframe-able URL into a VAiOS app.</p></div>\n    <button id=\"topPreviewBtn\" type=\"button\" class=\"ghost\">Preview</button>\n    <button id=\"topDownloadBtn\" type=\"button\" class=\"primary\">Download .vaios</button>\n  </div>\n  <div class=\"main\">\n    <div class=\"panel side\">\n      <div class=\"card\">\n        <h2>1. URL</h2>\n        <div class=\"label\">Website URL</div>\n        <input id=\"urlInput\" placeholder=\"https://example.com\" inputmode=\"url\" autocomplete=\"url\">\n        <div class=\"row\" style=\"margin-top:8px\">\n          <button id=\"previewBtn\" type=\"button\" class=\"primary\">Preview URL</button>\n          <button id=\"externalBtn\" type=\"button\" class=\"ghost\">Open External</button>\n          <button id=\"clearBtn\" type=\"button\" class=\"ghost\">Clear</button>\n        </div>\n        <p class=\"muted tiny\">The final app directly iframes the URL. Sites with iframe-blocking headers still cannot be forced from HTML.</p>\n      </div>\n      <div class=\"card\">\n        <h2>2. App metadata</h2>\n        <div class=\"label\">App name</div><input id=\"nameInput\" value=\"Web URL App\">\n        <div class=\"label\">Entry name</div><input id=\"entryInput\" value=\"Web URL\">\n        <div class=\"grid two\"><div><div class=\"label\">Category 1</div><input id=\"cat1Input\" value=\"Internet\"></div><div><div class=\"label\">Category 2</div><input id=\"cat2Input\" value=\"Web Apps\"></div></div>\n        <div class=\"grid two\"><div><div class=\"label\">Width</div><input id=\"widthInput\" type=\"number\" min=\"320\" max=\"2200\" value=\"1200\"></div><div><div class=\"label\">Height</div><input id=\"heightInput\" type=\"number\" min=\"240\" max=\"1800\" value=\"800\"></div></div>\n        <div class=\"label\">Icon</div><input id=\"iconInput\" value=\"🌐\">\n        <label class=\"row tiny\" style=\"margin-top:8px\"><input id=\"topbarInput\" type=\"checkbox\" checked style=\"width:auto\"> Include URL toolbar in final app</label>\n        <label class=\"row tiny\"><input id=\"bigInput\" type=\"checkbox\" style=\"width:auto\"> Prefer fullscreen-sized window</label>\n      </div>\n      <div class=\"card\">\n        <h2>3. Export</h2>\n        <div class=\"row\"><button id=\"downloadBtn\" type=\"button\" class=\"primary grow\">Download .vaios</button><button id=\"htmlBtn\" type=\"button\" class=\"ghost\">Download HTML</button></div>\n        <div class=\"row\" style=\"margin-top:7px\"><button id=\"jsonBtn\" type=\"button\" class=\"ghost grow\">Show JSON fallback</button><button id=\"testBtn\" type=\"button\" class=\"ghost\">Test</button></div>\n        <div id=\"status\" class=\"status tiny\" style=\"margin-top:8px\">JS loading...</div>\n      </div>\n      <div class=\"card\">\n        <h3>Fallback JSON</h3>\n        <textarea id=\"fallbackBox\" class=\"fallback mono\" placeholder=\"If a browser blocks download, press Show JSON fallback and copy this into a .vaios file.\"></textarea>\n      </div>\n      <div class=\"card warnbox\"><h3>Iframe rule</h3><div class=\"tiny muted\">Blocked sites require an iframe-friendly URL, a local HTML copy, or a reverse proxy you control.</div></div>\n    </div>\n    <div class=\"panel previewPanel\">\n      <div class=\"previewBar\"><strong>Preview</strong><span id=\"previewUrl\" class=\"pill\">No URL loaded</span><span class=\"grow\"></span><button id=\"reloadBtn\" type=\"button\" class=\"small ghost\">Reload</button></div>\n      <div class=\"previewFrameWrap\"><iframe id=\"previewFrame\" class=\"preview\" allow=\"fullscreen; autoplay; clipboard-read; clipboard-write; encrypted-media; gamepad; pointer-lock; geolocation; microphone; camera\" allowfullscreen referrerpolicy=\"no-referrer-when-downgrade\"></iframe><div id=\"emptyOverlay\" class=\"empty\"><div><h2>URL Preview</h2><p class=\"muted\">Enter a URL and press Preview.</p></div></div></div>\n    </div>\n  </div>\n</div>\n<script>\n(function(){\n'use strict';\nfunction id(x){return document.getElementById(x)}\nfunction clean(v,f){v=String(v==null?'':v).replace(/\\s+/g,' ').trim();return (v||f||'Untitled').slice(0,96)}\nfunction slug(v){return clean(v,'app').toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-+|-+$/g,'').slice(0,52)||'app'}\nfunction nowIso(){return new Date().toISOString()}\nfunction bytes(v){return new Blob([String(v||'')]).size}\nfunction human(n){n=Number(n)||0;var u=['B','KB','MB','GB'];var i=0;while(n>=1024&&i<u.length-1){n/=1024;i++}return (i?n.toFixed(n<10?2:1):Math.round(n))+u[i]}\nfunction status(msg,kind){var el=id('status');if(el){el.textContent=msg;el.className='status tiny '+(kind||'')}}\nfunction esc(s){return String(s==null?'':s).replace(/[&<>\\\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c]||c})}\nfunction attr(s){return esc(s).replace(/'/g,'&#39;')}\nfunction flash(btn){try{btn.classList.add('btnFlash');setTimeout(function(){btn.classList.remove('btnFlash')},180)}catch(e){}}\nfunction normalize(raw){raw=String(raw||'').trim();if(!raw)throw new Error('Enter a URL first.');if(!/^https?:\\/\\//i.test(raw))raw='https://'+raw;var u=new URL(raw);if(u.protocol!=='http:'&&u.protocol!=='https:')throw new Error('Only http:// and https:// URLs are supported.');return u.href}\nfunction updateNames(){try{var u=new URL(normalize(id('urlInput').value));var host=u.hostname.replace(/^www\\./,'');if(!id('nameInput').value||id('nameInput').value==='Web URL App')id('nameInput').value=host+' App';if(!id('entryInput').value||id('entryInput').value==='Web URL')id('entryInput').value=host}catch(e){}}\nfunction finalHtml(){var url=normalize(id('urlInput').value);var title=clean(id('nameInput').value,'Web URL App');var withBar=!!id('topbarInput').checked;var rows=withBar?'38px 1fr':'1fr';var parts=['<!doctype html>','<html lang=\"en\">','<head>','<meta charset=\"utf-8\">','<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover\">','<title>'+esc(title)+'</title>','<style>html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#000;font-family:system-ui,-apple-system,Segoe UI,sans-serif}body{display:grid;grid-template-rows:'+rows+'}.bar{height:38px;display:flex;align-items:center;gap:8px;padding:4px 8px;background:#031008;color:#eafff0;border-bottom:1px solid #14532d;font-size:12px}.bar strong{white-space:nowrap}.bar span{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#9fd1ac;flex:1}.bar a{background:#14532d;color:#eafff0;border:1px solid #86efac;border-radius:7px;padding:4px 8px;font:inherit;text-decoration:none;font-weight:800}iframe{width:100%;height:100%;border:0;background:#fff;display:block}body.vaios-clean-fullscreen{grid-template-rows:1fr!important}body.vaios-clean-fullscreen .bar{display:none!important}</style>','</head>','<body>'];if(withBar)parts.push('<div class=\"bar\"><strong>'+esc(title)+'</strong><span>'+esc(url)+'</span><a target=\"_blank\" rel=\"noopener noreferrer\" href=\"'+attr(url)+'\">Open external</a></div>');var cleanScript='<script>(function(){function setClean(h){try{if(document.body)document.body.classList.toggle(\"vaios-clean-fullscreen\",!!h)}catch(e){}}window.addEventListener(\"message\",function(ev){var m=ev.data||{};if(m&&m.__vdesktop_url_app_fullscreen)setClean(!!m.hideHeader)},false);document.addEventListener(\"fullscreenchange\",function(){setClean(!!document.fullscreenElement)},false);})();<\\/script>';parts.push('<iframe id=\"webframe\" src=\"'+attr(url)+'\" allow=\"fullscreen; autoplay; clipboard-read; clipboard-write; encrypted-media; gamepad; pointer-lock; geolocation; microphone; camera\" allowfullscreen referrerpolicy=\"no-referrer-when-downgrade\"></iframe>',cleanScript,'<\\/body>','<\\/html>');return parts.join('\\n')}\nfunction buildPkg(){var url=normalize(id('urlInput').value);var html=finalHtml();var created=nowIso();var name=clean(id('nameInput').value,'Web URL App');var entry=clean(id('entryInput').value,name);var itemId='url_app_'+slug(name)+'_'+Date.now().toString(36);var width=Math.max(320,Math.min(2200,Number(id('widthInput').value)||1200));var height=Math.max(240,Math.min(1800,Number(id('heightInput').value)||800));if(id('bigInput').checked){width=Math.max(width,1500);height=Math.max(height,1000)}var item={id:itemId,type:'app',name:name,category1:clean(id('cat1Input').value,'Internet'),category2:clean(id('cat2Input').value,'Web Apps'),entryName:entry,icon:clean(id('iconInput').value,'🌐'),desktopIcon:true,preferredWidth:width,preferredHeight:height,html:html,notes:'Direct URL iframe app. Target URL: '+url,parentId:'',editPrompt:'',version:1,baseName:name,createdAt:created,updatedAt:created,htmlSize:bytes(html),externalUrl:url};var folder='/Apps/'+slug(name);var manifest={id:item.id,type:item.type,name:item.name,entryName:item.entryName,category1:item.category1,category2:item.category2,icon:item.icon,desktopIcon:item.desktopIcon,preferredWidth:item.preferredWidth,preferredHeight:item.preferredHeight,notes:item.notes,version:item.version,baseName:item.baseName,createdAt:item.createdAt,updatedAt:item.updatedAt,externalUrl:url,folder:folder,sourcePath:folder+'/index.html'};return {kind:'vaios-app-package',extension:'vaios',version:1,createdAt:created,desktop:'Virtual Desktop Builder',item:item,folder:folder,files:{'index.html':html,'manifest.json':JSON.stringify(manifest,null,2),'item.json':JSON.stringify(item,null,2),'readme.txt':'URL to VAiOS app. Target URL: '+url+'\\n'}}}\nfunction looksSvg(v){return /^<svg[\\s>]/i.test(String(v||'').trim())}\nfunction firstJsonObject(s){s=String(s||'');var start=s.indexOf('{');if(start<0)return'';var depth=0,ins=false,escp=false;for(var i=start;i<s.length;i++){var ch=s[i];if(ins){if(escp){escp=false;continue}if(ch==='\\\\'){escp=true;continue}if(ch==='\"'){ins=false}continue}if(ch==='\"'){ins=true;continue}if(ch==='{')depth++;if(ch==='}'){depth--;if(depth===0)return s.slice(start,i+1)}}return s.slice(start)}\nfunction parseMeta(raw){try{return JSON.parse(firstJsonObject(raw)||raw||'{}')}catch(e){return {}}}\nfunction clamp(n,min,max,fallback){n=Number(n);if(!isFinite(n))n=fallback;return Math.max(min,Math.min(max,n))}\nvar __vdSeq=0,__vdPending={};\nwindow.addEventListener('message',function(ev){var r=ev.data||{};if(!r.__vdesktop_reply||!r.requestId||!__vdPending[r.requestId])return;var p=__vdPending[r.requestId];delete __vdPending[r.requestId];if(r.ok)p.resolve(r.result);else p.reject(new Error(r.error||'VDesktop request failed'));});\nfunction callDesktop(action,payload,timeout){return new Promise(function(resolve,reject){if(!(window.parent&&window.parent!==window&&typeof window.parent.postMessage==='function')){reject(new Error('Not running inside the VAiOS desktop iframe.'));return}var rid='urlvaios_'+(++__vdSeq)+'_'+Date.now();var timer=setTimeout(function(){if(__vdPending[rid]){delete __vdPending[rid];reject(new Error('Desktop bridge timed out: '+action));}},timeout||300000);__vdPending[rid]={resolve:function(v){clearTimeout(timer);resolve(v)},reject:function(e){clearTimeout(timer);reject(e)}};var msg=Object.assign({__vdesktop:true,action:action,requestId:rid},payload||{});window.parent.postMessage(msg,'*');});}\nfunction desktopAIReady(){return !!((window.VDesktop&&typeof window.VDesktop.askAI==='function')||(window.parent&&window.parent!==window&&typeof window.parent.postMessage==='function'))}\nfunction desktopInstallReady(){return !!((window.VDesktop&&typeof window.VDesktop.installVaiosText==='function')||(window.parent&&window.parent!==window&&typeof window.parent.postMessage==='function'))}\nfunction desktopAskAI(systemPrompt,userPrompt,kind){if(window.VDesktop&&typeof window.VDesktop.askAI==='function')return window.VDesktop.askAI(systemPrompt,userPrompt,kind);return callDesktop('askAI',{systemPrompt:String(systemPrompt||''),userPrompt:String(userPrompt||''),kind:kind||'html'},300000)}\nfunction desktopInstallVaiosText(raw,opts){opts=opts||{};if(window.VDesktop&&typeof window.VDesktop.installVaiosText==='function')return window.VDesktop.installVaiosText(raw,opts);return callDesktop('installVaiosText',Object.assign({raw:String(raw||'')},opts),300000)}\nfunction refreshPkgFiles(pkg){var item=pkg.item,url=item.externalUrl,folder='/Apps/'+slug(item.name);pkg.folder=folder;var manifest={id:item.id,type:item.type,name:item.name,entryName:item.entryName,category1:item.category1,category2:item.category2,icon:item.icon,desktopIcon:item.desktopIcon,preferredWidth:item.preferredWidth,preferredHeight:item.preferredHeight,notes:item.notes,version:item.version,baseName:item.baseName,createdAt:item.createdAt,updatedAt:item.updatedAt,externalUrl:url,folder:folder,sourcePath:folder+'/index.html'};pkg.files['manifest.json']=JSON.stringify(manifest,null,2);pkg.files['item.json']=JSON.stringify(item,null,2);pkg.files['readme.txt']='URL to VAiOS app. Target URL: '+url+'\\n';return pkg}\nfunction fallbackUrlSvg(name,url){\n  var label=clean(name||'URL','URL').slice(0,2).toUpperCase().replace(/[^A-Z0-9]/g,'');\n  var host='';try{host=new URL(url||'').hostname.replace(/^www\\./,'').slice(0,22)}catch(e){}\n  return '<svg viewBox=\"0 0 64 64\" xmlns=\"http://www.w3.org/2000/svg\"><rect x=\"5\" y=\"7\" width=\"54\" height=\"50\" rx=\"10\" fill=\"#031008\" stroke=\"#86efac\" stroke-width=\"3\"/><circle cx=\"32\" cy=\"31\" r=\"17\" fill=\"#052e16\" stroke=\"#22c55e\" stroke-width=\"3\"/><path d=\"M15 31h34M32 14c6 8 6 26 0 34M32 14c-6 8-6 26 0 34\" stroke=\"#bbf7d0\" stroke-width=\"2\" fill=\"none\"/><text x=\"32\" y=\"53\" font-family=\"Arial,sans-serif\" font-size=\"7\" text-anchor=\"middle\" fill=\"#eafff0\">'+esc(host||label||'URL')+'</text></svg>';\n}\nfunction markPkgFiles(pkg,item,manifest){\n  pkg.item=item;\n  pkg.files=pkg.files||{};\n  pkg.files['item.json']=JSON.stringify(item,null,2);\n  pkg.files['manifest.json']=JSON.stringify(manifest||Object.assign({},item,{html:undefined,folder:pkg.folder,sourcePath:pkg.folder+'/index.html'}),null,2);\n  return pkg;\n}\nasync function enhancePkgWithLLM(pkg){\n  var item=pkg.item||{};\n  var html=String((pkg.files&&pkg.files['index.html'])||item.html||'').slice(0,8000);\n  var context='Target URL: '+String(item.externalUrl||'')+'\\nCurrent name: '+String(item.name||'')+'\\nCurrent category: '+String(item.category1||'')+' / '+String(item.category2||'')+'\\nHTML start:\\n'+html.slice(0,4000);\n  var notes=[];\n  var icon=item.icon;\n  if(!desktopAIReady()){\n    notes.push('Desktop LLM bridge unavailable. Used generated fallback SVG/metadata.');\n    icon=fallbackUrlSvg(item.name,item.externalUrl);\n  }else{\n    try{\n      status('LLM pass 1/2: making SVG icon...','ok');\n      var svg=await desktopAskAI(\n        'Return ONLY one inline SVG element. No markdown. No JSON. Use <svg viewBox=\"0 0 64 64\" xmlns=\"http://www.w3.org/2000/svg\">. No scripts. No external images. Make it clear as a small VAiOS desktop icon.',\n        'Create an SVG icon for a VAiOS app that directly iframes this website. The icon should represent the target URL, not the builder tool itself.\\n\\n'+context,\n        'svg'\n      );\n      svg=stripFence(svg).replace(/^.*?(<svg[\\s\\S]*<\\/svg>).*$/i,'$1').trim();\n      if(looksSvg(svg))icon=svg;else throw new Error('LLM did not return valid SVG.');\n    }catch(e){notes.push('SVG LLM skipped: '+(e&&e.message?e.message:String(e)));icon=fallbackUrlSvg(item.name,item.externalUrl)}\n  }\n  var meta=null;\n  if(desktopAIReady()){\n    try{\n      status('LLM pass 2/2: making metadata...','ok');\n      var raw=await desktopAskAI(\n        'Return ONLY strict JSON. Shape: {\"type\":\"app\",\"name\":\"short display name\",\"category1\":\"Internet\",\"category2\":\"Web Apps\",\"entryName\":\"menu name\",\"desktopIcon\":true,\"preferredWidth\":1200,\"preferredHeight\":800}. No markdown.',\n        'Create clean VAiOS metadata for this URL iframe app. Keep the name short and useful. Metadata should describe the target website/app, not the URL-to-VAiOS builder.\\n\\n'+context,\n        'json'\n      );\n      meta=parseJsonLoose(raw);\n      if(!meta||typeof meta!=='object')throw new Error('LLM metadata was not JSON.');\n    }catch(e){notes.push('Metadata LLM skipped: '+(e&&e.message?e.message:String(e)))}\n  }\n  if(meta){\n    item.name=clean(meta.name,item.name);\n    item.entryName=clean(meta.entryName||meta.name,item.entryName||item.name);\n    item.category1=clean(meta.category1,item.category1||'Internet');\n    item.category2=clean(meta.category2,item.category2||'Web Apps');\n    item.desktopIcon=meta.desktopIcon!==false;\n    item.preferredWidth=Math.max(320,Math.min(2200,Number(meta.preferredWidth)||item.preferredWidth||1200));\n    item.preferredHeight=Math.max(240,Math.min(1800,Number(meta.preferredHeight)||item.preferredHeight||800));\n    pkg.folder='/Apps/'+slug(item.name);\n  }\n  item.icon=icon;\n  item.updatedAt=nowIso();\n  item.notes='Direct URL iframe app. Target URL: '+item.externalUrl+'\\nSVG icon and metadata pass ran during .vaios download.'+(notes.length?'\\n'+notes.join('\\n'):'');\n  var manifest={id:item.id,type:item.type,name:item.name,entryName:item.entryName,category1:item.category1,category2:item.category2,icon:item.icon,desktopIcon:item.desktopIcon,preferredWidth:item.preferredWidth,preferredHeight:item.preferredHeight,notes:item.notes,version:item.version,baseName:item.baseName,createdAt:item.createdAt,updatedAt:item.updatedAt,externalUrl:item.externalUrl,folder:pkg.folder,sourcePath:pkg.folder+'/index.html'};\n  if(notes.length)status('LLM had an issue, but package is still valid.\\n'+notes.join('\\n'),'warn');\n  else status('LLM SVG/metadata complete. Packaging .vaios...','ok');\n  return markPkgFiles(pkg,item,manifest);\n}\nfunction download(name,data,type){var blob=new Blob([data],{type:type||'application/octet-stream'});var u=URL.createObjectURL(blob);var a=document.createElement('a');a.href=u;a.download=name;a.rel='noopener';document.body.appendChild(a);a.click();setTimeout(function(){URL.revokeObjectURL(u);a.remove()},1500)}\nfunction preview(){updateNames();var url=normalize(id('urlInput').value);var frame=id('previewFrame');frame.removeAttribute('srcdoc');frame.src='about:blank';setTimeout(function(){frame.src=url},30);id('emptyOverlay').style.display='none';id('previewUrl').textContent=url;status('Preview requested.\\nURL: '+url+'\\nIf this stays blank or shows a block page, the site blocks iframes.','ok')}\nfunction reloadPreview(){var f=id('previewFrame');if(f&&f.src){var s=f.src;f.src='about:blank';setTimeout(function(){f.src=s},30);status('Reloaded preview.','ok')}}\nfunction openExternal(){window.open(normalize(id('urlInput').value),'_blank','noopener,noreferrer')}\nfunction clearAll(){id('urlInput').value='';id('previewFrame').removeAttribute('src');id('previewFrame').src='about:blank';id('emptyOverlay').style.display='grid';id('previewUrl').textContent='No URL loaded';id('fallbackBox').value='';status('Cleared. Enter a URL, then press Preview or Download.','ok')}\nfunction showJson(){updateNames();var data=JSON.stringify(buildPkg(),null,2);id('fallbackBox').value=data;status('Built VAiOS JSON fallback. Size: '+human(bytes(data)),'ok')}\nasync function downloadVaios(){updateNames();var pkg=buildPkg();pkg=await enhancePkgWithLLM(pkg);var data=JSON.stringify(pkg,null,2);id('fallbackBox').value=data;download(slug(pkg.item.name)+'.vaios',data,'application/vnd.vaios+json');status('Download requested.\\nName: '+pkg.item.name+'\\nURL: '+pkg.item.externalUrl+'\\nPackage: '+human(bytes(data)),'ok');if(desktopInstallReady()){try{status('Download complete. Asking desktop if you want to install it...','ok');var res=await desktopInstallVaiosText(data,{ask:true,openAfter:false});if(res&&res.installed)status('Downloaded and installed: '+res.name,'ok');else status('Downloaded. Install skipped.','ok')}catch(e){status('Downloaded, but install request failed: '+(e&&e.message?e.message:String(e)),'warn')}}else{status('Downloaded. Install prompt needs this app running inside the Virtual Desktop.','warn')}}\nfunction downloadHtml(){var h=finalHtml();download(slug(id('nameInput').value||'url-app')+'.html',h,'text/html');status('Downloaded generated HTML. Size: '+human(bytes(h)),'ok')}\nfunction testBuild(){updateNames();var pkg=buildPkg();status('Build OK.\\nName: '+pkg.item.name+'\\nURL: '+pkg.item.externalUrl+'\\nHTML: '+human(pkg.item.htmlSize)+'\\nPackage: '+human(bytes(JSON.stringify(pkg,null,2))),'ok')}\nfunction run(fn,btn){return function(ev){if(ev){ev.preventDefault();ev.stopPropagation();flash(btn||ev.currentTarget)}try{var r=fn();if(r&&typeof r.then==='function')r.catch(function(e){status('ERROR: '+(e&&e.message?e.message:String(e)),'err')})}catch(e){status('ERROR: '+(e&&e.message?e.message:String(e)),'err')}}}\nwindow.VAIOS_URL_BUILDER={preview:run(preview),reloadPreview:run(reloadPreview),openExternal:run(openExternal),clearAll:run(clearAll),buildPkg:buildPkg,showJson:run(showJson),downloadVaios:run(downloadVaios),downloadHtml:run(downloadHtml),testBuild:run(testBuild)};\nvar bindings=[['topPreviewBtn',preview],['previewBtn',preview],['topDownloadBtn',downloadVaios],['downloadBtn',downloadVaios],['externalBtn',openExternal],['clearBtn',clearAll],['htmlBtn',downloadHtml],['jsonBtn',showJson],['testBtn',testBuild],['reloadBtn',reloadPreview]];\nfor(var i=0;i<bindings.length;i++){(function(pair){var b=id(pair[0]);if(b)b.addEventListener('click',run(pair[1],b),false)})(bindings[i])}\nvar urlInput=id('urlInput');if(urlInput){urlInput.addEventListener('keydown',function(ev){if(ev.key==='Enter')run(preview)(ev)},false);urlInput.addEventListener('change',updateNames,false)}\nstatus('JS online. Built-in VAiOS system app. Enter a URL, then press Preview or Download. Download .vaios calls the desktop LLM for SVG + metadata. If the local LLM fetch fails, it still downloads a valid package with generated fallback SVG/metadata.','ok')\n})();\n</script>\n</body>\n</html>\n",
    "manifest.json": "{\n  \"id\": \"url-to-vaios-builder-sandbox-safe\",\n  \"type\": \"app\",\n  \"name\": \"URL to VAiOS\",\n  \"category1\": \"Internet\",\n  \"category2\": \"Builders\",\n  \"entryName\": \"URL to VAiOS\",\n  \"icon\": \"\\ud83c\\udf10\",\n  \"desktopIcon\": true,\n  \"preferredWidth\": 1180,\n  \"preferredHeight\": 780,\n  \"notes\": \"Standalone copy. The fixed desktop includes this as a built-in System app and defaults LLM to http://127.0.0.1:8205.\",\n  \"parentId\": \"\",\n  \"editPrompt\": \"\",\n  \"version\": \"llm-svg-metadata-force-bridge-v2\",\n  \"baseName\": \"URL to VAiOS Builder\",\n  \"createdAt\": \"2026-06-23T01:11:07Z\",\n  \"updatedAt\": \"2026-06-23T01:44:03Z\",\n  \"htmlSize\": 25378\n}",
    "item.json": "{\n  \"id\": \"url-to-vaios-builder-sandbox-safe\",\n  \"type\": \"app\",\n  \"name\": \"URL to VAiOS\",\n  \"category1\": \"Internet\",\n  \"category2\": \"Builders\",\n  \"entryName\": \"URL to VAiOS\",\n  \"icon\": \"\\ud83c\\udf10\",\n  \"desktopIcon\": true,\n  \"preferredWidth\": 1180,\n  \"preferredHeight\": 780,\n  \"html\": \"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n<meta charset=\\\"utf-8\\\">\\n<meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover\\\">\\n<title>URL to VAiOS Builder</title>\\n<style>\\n:root{--bg:#020604;--panel:#06180d;--panel2:#0a2414;--line:#2d6841;--line2:#86efac;--text:#eafff0;--muted:#a4d4af;--accent:#22c55e;--bad:#ef4444;--warn:#eab308;--shadow:0 16px 40px rgba(0,0,0,.45)}\\n*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:linear-gradient(135deg,#020604,#062514);color:var(--text);font-family:Tahoma,system-ui,-apple-system,Segoe UI,Roboto,sans-serif}button,input,select,textarea{font:inherit;color:var(--text);min-width:0}button{border:2px solid #244a34;border-top-color:#a7f3b7;border-left-color:#a7f3b7;border-right-color:#020604;border-bottom-color:#020604;background:#14532d;padding:9px 11px;font-weight:900;border-radius:10px;cursor:pointer}button:hover{filter:brightness(1.12)}button:active{transform:translateY(1px);border-color:#020604 #a7f3b7 #a7f3b7 #020604}.primary{background:#15803d}.bad{background:#7f1d1d}.warn{background:#854d0e}.ghost{background:#07180d}.small{font-size:12px;padding:5px 8px}input,select,textarea{width:100%;background:#031008;border:2px inset #2c6240;border-radius:8px;padding:8px;outline:none}textarea{min-height:84px;resize:vertical;user-select:text}.wrap{height:100vh;display:grid;grid-template-rows:auto 1fr}.top{display:flex;gap:10px;align-items:center;padding:10px 12px;border-bottom:2px solid var(--line2);background:#063819;box-shadow:var(--shadow);z-index:2}.logo{width:38px;height:38px;border:2px solid #bbf7d0;border-radius:10px;display:grid;place-items:center;background:#052e16;font-size:23px}.top h1{font-size:18px;margin:0}.top p{font-size:12px;color:#b7e7c2;margin:2px 0 0}.main{min-height:0;display:grid;grid-template-columns:minmax(300px,430px) minmax(0,1fr);gap:10px;padding:10px}.panel{min-height:0;background:rgba(3,16,8,.90);border:2px solid var(--line);box-shadow:var(--shadow);border-radius:12px;overflow:auto}.side{padding:10px}.card{border:1px solid #255638;background:#06180d;padding:10px;border-radius:10px;margin-bottom:10px}.card h2,.card h3{margin:0 0 8px;font-size:15px}.grid{display:grid;gap:8px}.two{grid-template-columns:1fr 1fr}.row{display:flex;gap:7px;align-items:center;flex-wrap:wrap}.grow{flex:1}.muted{color:var(--muted)}.tiny{font-size:11px}.label{font-size:11px;color:#bdf4cb;font-weight:900;text-transform:uppercase;letter-spacing:.07em;margin:8px 0 5px}.status{white-space:pre-wrap;user-select:text;overflow-wrap:anywhere;background:#020d06;border:2px inset #255638;border-radius:9px;padding:8px;min-height:70px}.previewPanel{display:grid;grid-template-rows:auto 1fr}.previewBar{display:flex;align-items:center;gap:7px;padding:8px;background:#041109;border-bottom:2px solid #255638}.previewBar strong{font-size:13px}.previewFrameWrap{min-height:0;background:#111;position:relative}.preview{width:100%;height:100%;border:0;background:#fff;display:block}.empty{position:absolute;inset:0;display:grid;place-items:center;text-align:center;background:linear-gradient(135deg,#020604,#041b0c);pointer-events:none}.pill{display:inline-flex;align-items:center;max-width:60%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;border:1px solid #255638;border-radius:999px;padding:3px 8px;color:#bdf4cb;background:#031008}.warnbox{border-color:#715b13;background:#1d1603}.ok{color:#86efac}.err{color:#fca5a5}.mono{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace}.fallback{min-height:160px;font-size:11px}.btnFlash{outline:2px solid #86efac;outline-offset:2px}\\n@media(max-width:820px){.main{grid-template-columns:1fr;overflow:auto}.wrap{overflow:auto}.panel{overflow:visible}.previewPanel{height:70vh}.top h1{font-size:15px}}\\n</style>\\n</head>\\n<body>\\n<div class=\\\"wrap\\\">\\n  <div class=\\\"top\\\">\\n    <div class=\\\"logo\\\">\\ud83c\\udf10</div>\\n    <div class=\\\"grow\\\"><h1>URL \\u2192 VAiOS Builder</h1><p>Turn any iframe-able URL into a VAiOS app.</p></div>\\n    <button id=\\\"topPreviewBtn\\\" type=\\\"button\\\" class=\\\"ghost\\\">Preview</button>\\n    <button id=\\\"topDownloadBtn\\\" type=\\\"button\\\" class=\\\"primary\\\">Download .vaios</button>\\n  </div>\\n  <div class=\\\"main\\\">\\n    <div class=\\\"panel side\\\">\\n      <div class=\\\"card\\\">\\n        <h2>1. URL</h2>\\n        <div class=\\\"label\\\">Website URL</div>\\n        <input id=\\\"urlInput\\\" placeholder=\\\"https://example.com\\\" inputmode=\\\"url\\\" autocomplete=\\\"url\\\">\\n        <div class=\\\"row\\\" style=\\\"margin-top:8px\\\">\\n          <button id=\\\"previewBtn\\\" type=\\\"button\\\" class=\\\"primary\\\">Preview URL</button>\\n          <button id=\\\"externalBtn\\\" type=\\\"button\\\" class=\\\"ghost\\\">Open External</button>\\n          <button id=\\\"clearBtn\\\" type=\\\"button\\\" class=\\\"ghost\\\">Clear</button>\\n        </div>\\n        <p class=\\\"muted tiny\\\">The final app directly iframes the URL. Sites with iframe-blocking headers still cannot be forced from HTML.</p>\\n      </div>\\n      <div class=\\\"card\\\">\\n        <h2>2. App metadata</h2>\\n        <div class=\\\"label\\\">App name</div><input id=\\\"nameInput\\\" value=\\\"Web URL App\\\">\\n        <div class=\\\"label\\\">Entry name</div><input id=\\\"entryInput\\\" value=\\\"Web URL\\\">\\n        <div class=\\\"grid two\\\"><div><div class=\\\"label\\\">Category 1</div><input id=\\\"cat1Input\\\" value=\\\"Internet\\\"></div><div><div class=\\\"label\\\">Category 2</div><input id=\\\"cat2Input\\\" value=\\\"Web Apps\\\"></div></div>\\n        <div class=\\\"grid two\\\"><div><div class=\\\"label\\\">Width</div><input id=\\\"widthInput\\\" type=\\\"number\\\" min=\\\"320\\\" max=\\\"2200\\\" value=\\\"1200\\\"></div><div><div class=\\\"label\\\">Height</div><input id=\\\"heightInput\\\" type=\\\"number\\\" min=\\\"240\\\" max=\\\"1800\\\" value=\\\"800\\\"></div></div>\\n        <div class=\\\"label\\\">Icon</div><input id=\\\"iconInput\\\" value=\\\"\\ud83c\\udf10\\\">\\n        <label class=\\\"row tiny\\\" style=\\\"margin-top:8px\\\"><input id=\\\"topbarInput\\\" type=\\\"checkbox\\\" checked style=\\\"width:auto\\\"> Include URL toolbar in final app</label>\\n        <label class=\\\"row tiny\\\"><input id=\\\"bigInput\\\" type=\\\"checkbox\\\" style=\\\"width:auto\\\"> Prefer fullscreen-sized window</label>\\n      </div>\\n      <div class=\\\"card\\\">\\n        <h2>3. Export</h2>\\n        <div class=\\\"row\\\"><button id=\\\"downloadBtn\\\" type=\\\"button\\\" class=\\\"primary grow\\\">Download .vaios</button><button id=\\\"htmlBtn\\\" type=\\\"button\\\" class=\\\"ghost\\\">Download HTML</button></div>\\n        <div class=\\\"row\\\" style=\\\"margin-top:7px\\\"><button id=\\\"jsonBtn\\\" type=\\\"button\\\" class=\\\"ghost grow\\\">Show JSON fallback</button><button id=\\\"testBtn\\\" type=\\\"button\\\" class=\\\"ghost\\\">Test</button></div>\\n        <div id=\\\"status\\\" class=\\\"status tiny\\\" style=\\\"margin-top:8px\\\">JS loading...</div>\\n      </div>\\n      <div class=\\\"card\\\">\\n        <h3>Fallback JSON</h3>\\n        <textarea id=\\\"fallbackBox\\\" class=\\\"fallback mono\\\" placeholder=\\\"If a browser blocks download, press Show JSON fallback and copy this into a .vaios file.\\\"></textarea>\\n      </div>\\n      <div class=\\\"card warnbox\\\"><h3>Iframe rule</h3><div class=\\\"tiny muted\\\">Blocked sites require an iframe-friendly URL, a local HTML copy, or a reverse proxy you control.</div></div>\\n    </div>\\n    <div class=\\\"panel previewPanel\\\">\\n      <div class=\\\"previewBar\\\"><strong>Preview</strong><span id=\\\"previewUrl\\\" class=\\\"pill\\\">No URL loaded</span><span class=\\\"grow\\\"></span><button id=\\\"reloadBtn\\\" type=\\\"button\\\" class=\\\"small ghost\\\">Reload</button></div>\\n      <div class=\\\"previewFrameWrap\\\"><iframe id=\\\"previewFrame\\\" class=\\\"preview\\\" allow=\\\"fullscreen; autoplay; clipboard-read; clipboard-write; encrypted-media; gamepad; pointer-lock; geolocation; microphone; camera\\\" allowfullscreen referrerpolicy=\\\"no-referrer-when-downgrade\\\"></iframe><div id=\\\"emptyOverlay\\\" class=\\\"empty\\\"><div><h2>URL Preview</h2><p class=\\\"muted\\\">Enter a URL and press Preview.</p></div></div></div>\\n    </div>\\n  </div>\\n</div>\\n<script>\\n(function(){\\n'use strict';\\nfunction id(x){return document.getElementById(x)}\\nfunction clean(v,f){v=String(v==null?'':v).replace(/\\\\s+/g,' ').trim();return (v||f||'Untitled').slice(0,96)}\\nfunction slug(v){return clean(v,'app').toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-+|-+$/g,'').slice(0,52)||'app'}\\nfunction nowIso(){return new Date().toISOString()}\\nfunction bytes(v){return new Blob([String(v||'')]).size}\\nfunction human(n){n=Number(n)||0;var u=['B','KB','MB','GB'];var i=0;while(n>=1024&&i<u.length-1){n/=1024;i++}return (i?n.toFixed(n<10?2:1):Math.round(n))+u[i]}\\nfunction status(msg,kind){var el=id('status');if(el){el.textContent=msg;el.className='status tiny '+(kind||'')}}\\nfunction esc(s){return String(s==null?'':s).replace(/[&<>\\\\\\\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\\\"':'&quot;'}[c]||c})}\\nfunction attr(s){return esc(s).replace(/'/g,'&#39;')}\\nfunction flash(btn){try{btn.classList.add('btnFlash');setTimeout(function(){btn.classList.remove('btnFlash')},180)}catch(e){}}\\nfunction normalize(raw){raw=String(raw||'').trim();if(!raw)throw new Error('Enter a URL first.');if(!/^https?:\\\\/\\\\//i.test(raw))raw='https://'+raw;var u=new URL(raw);if(u.protocol!=='http:'&&u.protocol!=='https:')throw new Error('Only http:// and https:// URLs are supported.');return u.href}\\nfunction updateNames(){try{var u=new URL(normalize(id('urlInput').value));var host=u.hostname.replace(/^www\\\\./,'');if(!id('nameInput').value||id('nameInput').value==='Web URL App')id('nameInput').value=host+' App';if(!id('entryInput').value||id('entryInput').value==='Web URL')id('entryInput').value=host}catch(e){}}\\nfunction finalHtml(){var url=normalize(id('urlInput').value);var title=clean(id('nameInput').value,'Web URL App');var withBar=!!id('topbarInput').checked;var rows=withBar?'38px 1fr':'1fr';var parts=['<!doctype html>','<html lang=\\\"en\\\">','<head>','<meta charset=\\\"utf-8\\\">','<meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover\\\">','<title>'+esc(title)+'</title>','<style>html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#000;font-family:system-ui,-apple-system,Segoe UI,sans-serif}body{display:grid;grid-template-rows:'+rows+'}.bar{height:38px;display:flex;align-items:center;gap:8px;padding:4px 8px;background:#031008;color:#eafff0;border-bottom:1px solid #14532d;font-size:12px}.bar strong{white-space:nowrap}.bar span{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#9fd1ac;flex:1}.bar a{background:#14532d;color:#eafff0;border:1px solid #86efac;border-radius:7px;padding:4px 8px;font:inherit;text-decoration:none;font-weight:800}iframe{width:100%;height:100%;border:0;background:#fff;display:block}body.vaios-clean-fullscreen{grid-template-rows:1fr!important}body.vaios-clean-fullscreen .bar{display:none!important}</style>','</head>','<body>'];if(withBar)parts.push('<div class=\\\"bar\\\"><strong>'+esc(title)+'</strong><span>'+esc(url)+'</span><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer\\\" href=\\\"'+attr(url)+'\\\">Open external</a></div>');var cleanScript='<script>(function(){function setClean(h){try{if(document.body)document.body.classList.toggle(\\\"vaios-clean-fullscreen\\\",!!h)}catch(e){}}window.addEventListener(\\\"message\\\",function(ev){var m=ev.data||{};if(m&&m.__vdesktop_url_app_fullscreen)setClean(!!m.hideHeader)},false);document.addEventListener(\\\"fullscreenchange\\\",function(){setClean(!!document.fullscreenElement)},false);})();<\\\\/script>';parts.push('<iframe id=\\\"webframe\\\" src=\\\"'+attr(url)+'\\\" allow=\\\"fullscreen; autoplay; clipboard-read; clipboard-write; encrypted-media; gamepad; pointer-lock; geolocation; microphone; camera\\\" allowfullscreen referrerpolicy=\\\"no-referrer-when-downgrade\\\"></iframe>',cleanScript,'<\\\\/body>','<\\\\/html>');return parts.join('\\\\n')}\\nfunction buildPkg(){var url=normalize(id('urlInput').value);var html=finalHtml();var created=nowIso();var name=clean(id('nameInput').value,'Web URL App');var entry=clean(id('entryInput').value,name);var itemId='url_app_'+slug(name)+'_'+Date.now().toString(36);var width=Math.max(320,Math.min(2200,Number(id('widthInput').value)||1200));var height=Math.max(240,Math.min(1800,Number(id('heightInput').value)||800));if(id('bigInput').checked){width=Math.max(width,1500);height=Math.max(height,1000)}var item={id:itemId,type:'app',name:name,category1:clean(id('cat1Input').value,'Internet'),category2:clean(id('cat2Input').value,'Web Apps'),entryName:entry,icon:clean(id('iconInput').value,'\\ud83c\\udf10'),desktopIcon:true,preferredWidth:width,preferredHeight:height,html:html,notes:'Direct URL iframe app. Target URL: '+url,parentId:'',editPrompt:'',version:1,baseName:name,createdAt:created,updatedAt:created,htmlSize:bytes(html),externalUrl:url};var folder='/Apps/'+slug(name);var manifest={id:item.id,type:item.type,name:item.name,entryName:item.entryName,category1:item.category1,category2:item.category2,icon:item.icon,desktopIcon:item.desktopIcon,preferredWidth:item.preferredWidth,preferredHeight:item.preferredHeight,notes:item.notes,version:item.version,baseName:item.baseName,createdAt:item.createdAt,updatedAt:item.updatedAt,externalUrl:url,folder:folder,sourcePath:folder+'/index.html'};return {kind:'vaios-app-package',extension:'vaios',version:1,createdAt:created,desktop:'Virtual Desktop Builder',item:item,folder:folder,files:{'index.html':html,'manifest.json':JSON.stringify(manifest,null,2),'item.json':JSON.stringify(item,null,2),'readme.txt':'URL to VAiOS app. Target URL: '+url+'\\\\n'}}}\\nfunction looksSvg(v){return /^<svg[\\\\s>]/i.test(String(v||'').trim())}\\nfunction firstJsonObject(s){s=String(s||'');var start=s.indexOf('{');if(start<0)return'';var depth=0,ins=false,escp=false;for(var i=start;i<s.length;i++){var ch=s[i];if(ins){if(escp){escp=false;continue}if(ch==='\\\\\\\\'){escp=true;continue}if(ch==='\\\"'){ins=false}continue}if(ch==='\\\"'){ins=true;continue}if(ch==='{')depth++;if(ch==='}'){depth--;if(depth===0)return s.slice(start,i+1)}}return s.slice(start)}\\nfunction parseMeta(raw){try{return JSON.parse(firstJsonObject(raw)||raw||'{}')}catch(e){return {}}}\\nfunction clamp(n,min,max,fallback){n=Number(n);if(!isFinite(n))n=fallback;return Math.max(min,Math.min(max,n))}\\nvar __vdSeq=0,__vdPending={};\\nwindow.addEventListener('message',function(ev){var r=ev.data||{};if(!r.__vdesktop_reply||!r.requestId||!__vdPending[r.requestId])return;var p=__vdPending[r.requestId];delete __vdPending[r.requestId];if(r.ok)p.resolve(r.result);else p.reject(new Error(r.error||'VDesktop request failed'));});\\nfunction callDesktop(action,payload,timeout){return new Promise(function(resolve,reject){if(!(window.parent&&window.parent!==window&&typeof window.parent.postMessage==='function')){reject(new Error('Not running inside the VAiOS desktop iframe.'));return}var rid='urlvaios_'+(++__vdSeq)+'_'+Date.now();var timer=setTimeout(function(){if(__vdPending[rid]){delete __vdPending[rid];reject(new Error('Desktop bridge timed out: '+action));}},timeout||300000);__vdPending[rid]={resolve:function(v){clearTimeout(timer);resolve(v)},reject:function(e){clearTimeout(timer);reject(e)}};var msg=Object.assign({__vdesktop:true,action:action,requestId:rid},payload||{});window.parent.postMessage(msg,'*');});}\\nfunction desktopAIReady(){return !!((window.VDesktop&&typeof window.VDesktop.askAI==='function')||(window.parent&&window.parent!==window&&typeof window.parent.postMessage==='function'))}\\nfunction desktopInstallReady(){return !!((window.VDesktop&&typeof window.VDesktop.installVaiosText==='function')||(window.parent&&window.parent!==window&&typeof window.parent.postMessage==='function'))}\\nfunction desktopAskAI(systemPrompt,userPrompt,kind){if(window.VDesktop&&typeof window.VDesktop.askAI==='function')return window.VDesktop.askAI(systemPrompt,userPrompt,kind);return callDesktop('askAI',{systemPrompt:String(systemPrompt||''),userPrompt:String(userPrompt||''),kind:kind||'html'},300000)}\\nfunction desktopInstallVaiosText(raw,opts){opts=opts||{};if(window.VDesktop&&typeof window.VDesktop.installVaiosText==='function')return window.VDesktop.installVaiosText(raw,opts);return callDesktop('installVaiosText',Object.assign({raw:String(raw||'')},opts),300000)}\\nfunction refreshPkgFiles(pkg){var item=pkg.item,url=item.externalUrl,folder='/Apps/'+slug(item.name);pkg.folder=folder;var manifest={id:item.id,type:item.type,name:item.name,entryName:item.entryName,category1:item.category1,category2:item.category2,icon:item.icon,desktopIcon:item.desktopIcon,preferredWidth:item.preferredWidth,preferredHeight:item.preferredHeight,notes:item.notes,version:item.version,baseName:item.baseName,createdAt:item.createdAt,updatedAt:item.updatedAt,externalUrl:url,folder:folder,sourcePath:folder+'/index.html'};pkg.files['manifest.json']=JSON.stringify(manifest,null,2);pkg.files['item.json']=JSON.stringify(item,null,2);pkg.files['readme.txt']='URL to VAiOS app. Target URL: '+url+'\\\\n';return pkg}\\nfunction fallbackUrlSvg(name,url){\\n  var label=clean(name||'URL','URL').slice(0,2).toUpperCase().replace(/[^A-Z0-9]/g,'');\\n  var host='';try{host=new URL(url||'').hostname.replace(/^www\\\\./,'').slice(0,22)}catch(e){}\\n  return '<svg viewBox=\\\"0 0 64 64\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\"><rect x=\\\"5\\\" y=\\\"7\\\" width=\\\"54\\\" height=\\\"50\\\" rx=\\\"10\\\" fill=\\\"#031008\\\" stroke=\\\"#86efac\\\" stroke-width=\\\"3\\\"/><circle cx=\\\"32\\\" cy=\\\"31\\\" r=\\\"17\\\" fill=\\\"#052e16\\\" stroke=\\\"#22c55e\\\" stroke-width=\\\"3\\\"/><path d=\\\"M15 31h34M32 14c6 8 6 26 0 34M32 14c-6 8-6 26 0 34\\\" stroke=\\\"#bbf7d0\\\" stroke-width=\\\"2\\\" fill=\\\"none\\\"/><text x=\\\"32\\\" y=\\\"53\\\" font-family=\\\"Arial,sans-serif\\\" font-size=\\\"7\\\" text-anchor=\\\"middle\\\" fill=\\\"#eafff0\\\">'+esc(host||label||'URL')+'</text></svg>';\\n}\\nfunction markPkgFiles(pkg,item,manifest){\\n  pkg.item=item;\\n  pkg.files=pkg.files||{};\\n  pkg.files['item.json']=JSON.stringify(item,null,2);\\n  pkg.files['manifest.json']=JSON.stringify(manifest||Object.assign({},item,{html:undefined,folder:pkg.folder,sourcePath:pkg.folder+'/index.html'}),null,2);\\n  return pkg;\\n}\\nasync function enhancePkgWithLLM(pkg){\\n  var item=pkg.item||{};\\n  var html=String((pkg.files&&pkg.files['index.html'])||item.html||'').slice(0,8000);\\n  var context='Target URL: '+String(item.externalUrl||'')+'\\\\nCurrent name: '+String(item.name||'')+'\\\\nCurrent category: '+String(item.category1||'')+' / '+String(item.category2||'')+'\\\\nHTML start:\\\\n'+html.slice(0,4000);\\n  var notes=[];\\n  var icon=item.icon;\\n  if(!desktopAIReady()){\\n    notes.push('Desktop LLM bridge unavailable. Used generated fallback SVG/metadata.');\\n    icon=fallbackUrlSvg(item.name,item.externalUrl);\\n  }else{\\n    try{\\n      status('LLM pass 1/2: making SVG icon...','ok');\\n      var svg=await desktopAskAI(\\n        'Return ONLY one inline SVG element. No markdown. No JSON. Use <svg viewBox=\\\"0 0 64 64\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">. No scripts. No external images. Make it clear as a small VAiOS desktop icon.',\\n        'Create an SVG icon for a VAiOS app that directly iframes this website. The icon should represent the target URL, not the builder tool itself.\\\\n\\\\n'+context,\\n        'svg'\\n      );\\n      svg=stripFence(svg).replace(/^.*?(<svg[\\\\s\\\\S]*<\\\\/svg>).*$/i,'$1').trim();\\n      if(looksSvg(svg))icon=svg;else throw new Error('LLM did not return valid SVG.');\\n    }catch(e){notes.push('SVG LLM skipped: '+(e&&e.message?e.message:String(e)));icon=fallbackUrlSvg(item.name,item.externalUrl)}\\n  }\\n  var meta=null;\\n  if(desktopAIReady()){\\n    try{\\n      status('LLM pass 2/2: making metadata...','ok');\\n      var raw=await desktopAskAI(\\n        'Return ONLY strict JSON. Shape: {\\\"type\\\":\\\"app\\\",\\\"name\\\":\\\"short display name\\\",\\\"category1\\\":\\\"Internet\\\",\\\"category2\\\":\\\"Web Apps\\\",\\\"entryName\\\":\\\"menu name\\\",\\\"desktopIcon\\\":true,\\\"preferredWidth\\\":1200,\\\"preferredHeight\\\":800}. No markdown.',\\n        'Create clean VAiOS metadata for this URL iframe app. Keep the name short and useful. Metadata should describe the target website/app, not the URL-to-VAiOS builder.\\\\n\\\\n'+context,\\n        'json'\\n      );\\n      meta=parseJsonLoose(raw);\\n      if(!meta||typeof meta!=='object')throw new Error('LLM metadata was not JSON.');\\n    }catch(e){notes.push('Metadata LLM skipped: '+(e&&e.message?e.message:String(e)))}\\n  }\\n  if(meta){\\n    item.name=clean(meta.name,item.name);\\n    item.entryName=clean(meta.entryName||meta.name,item.entryName||item.name);\\n    item.category1=clean(meta.category1,item.category1||'Internet');\\n    item.category2=clean(meta.category2,item.category2||'Web Apps');\\n    item.desktopIcon=meta.desktopIcon!==false;\\n    item.preferredWidth=Math.max(320,Math.min(2200,Number(meta.preferredWidth)||item.preferredWidth||1200));\\n    item.preferredHeight=Math.max(240,Math.min(1800,Number(meta.preferredHeight)||item.preferredHeight||800));\\n    pkg.folder='/Apps/'+slug(item.name);\\n  }\\n  item.icon=icon;\\n  item.updatedAt=nowIso();\\n  item.notes='Direct URL iframe app. Target URL: '+item.externalUrl+'\\\\nSVG icon and metadata pass ran during .vaios download.'+(notes.length?'\\\\n'+notes.join('\\\\n'):'');\\n  var manifest={id:item.id,type:item.type,name:item.name,entryName:item.entryName,category1:item.category1,category2:item.category2,icon:item.icon,desktopIcon:item.desktopIcon,preferredWidth:item.preferredWidth,preferredHeight:item.preferredHeight,notes:item.notes,version:item.version,baseName:item.baseName,createdAt:item.createdAt,updatedAt:item.updatedAt,externalUrl:item.externalUrl,folder:pkg.folder,sourcePath:pkg.folder+'/index.html'};\\n  if(notes.length)status('LLM had an issue, but package is still valid.\\\\n'+notes.join('\\\\n'),'warn');\\n  else status('LLM SVG/metadata complete. Packaging .vaios...','ok');\\n  return markPkgFiles(pkg,item,manifest);\\n}\\nfunction download(name,data,type){var blob=new Blob([data],{type:type||'application/octet-stream'});var u=URL.createObjectURL(blob);var a=document.createElement('a');a.href=u;a.download=name;a.rel='noopener';document.body.appendChild(a);a.click();setTimeout(function(){URL.revokeObjectURL(u);a.remove()},1500)}\\nfunction preview(){updateNames();var url=normalize(id('urlInput').value);var frame=id('previewFrame');frame.removeAttribute('srcdoc');frame.src='about:blank';setTimeout(function(){frame.src=url},30);id('emptyOverlay').style.display='none';id('previewUrl').textContent=url;status('Preview requested.\\\\nURL: '+url+'\\\\nIf this stays blank or shows a block page, the site blocks iframes.','ok')}\\nfunction reloadPreview(){var f=id('previewFrame');if(f&&f.src){var s=f.src;f.src='about:blank';setTimeout(function(){f.src=s},30);status('Reloaded preview.','ok')}}\\nfunction openExternal(){window.open(normalize(id('urlInput').value),'_blank','noopener,noreferrer')}\\nfunction clearAll(){id('urlInput').value='';id('previewFrame').removeAttribute('src');id('previewFrame').src='about:blank';id('emptyOverlay').style.display='grid';id('previewUrl').textContent='No URL loaded';id('fallbackBox').value='';status('Cleared. Enter a URL, then press Preview or Download.','ok')}\\nfunction showJson(){updateNames();var data=JSON.stringify(buildPkg(),null,2);id('fallbackBox').value=data;status('Built VAiOS JSON fallback. Size: '+human(bytes(data)),'ok')}\\nasync function downloadVaios(){updateNames();var pkg=buildPkg();pkg=await enhancePkgWithLLM(pkg);var data=JSON.stringify(pkg,null,2);id('fallbackBox').value=data;download(slug(pkg.item.name)+'.vaios',data,'application/vnd.vaios+json');status('Download requested.\\\\nName: '+pkg.item.name+'\\\\nURL: '+pkg.item.externalUrl+'\\\\nPackage: '+human(bytes(data)),'ok');if(desktopInstallReady()){try{status('Download complete. Asking desktop if you want to install it...','ok');var res=await desktopInstallVaiosText(data,{ask:true,openAfter:false});if(res&&res.installed)status('Downloaded and installed: '+res.name,'ok');else status('Downloaded. Install skipped.','ok')}catch(e){status('Downloaded, but install request failed: '+(e&&e.message?e.message:String(e)),'warn')}}else{status('Downloaded. Install prompt needs this app running inside the Virtual Desktop.','warn')}}\\nfunction downloadHtml(){var h=finalHtml();download(slug(id('nameInput').value||'url-app')+'.html',h,'text/html');status('Downloaded generated HTML. Size: '+human(bytes(h)),'ok')}\\nfunction testBuild(){updateNames();var pkg=buildPkg();status('Build OK.\\\\nName: '+pkg.item.name+'\\\\nURL: '+pkg.item.externalUrl+'\\\\nHTML: '+human(pkg.item.htmlSize)+'\\\\nPackage: '+human(bytes(JSON.stringify(pkg,null,2))),'ok')}\\nfunction run(fn,btn){return function(ev){if(ev){ev.preventDefault();ev.stopPropagation();flash(btn||ev.currentTarget)}try{var r=fn();if(r&&typeof r.then==='function')r.catch(function(e){status('ERROR: '+(e&&e.message?e.message:String(e)),'err')})}catch(e){status('ERROR: '+(e&&e.message?e.message:String(e)),'err')}}}\\nwindow.VAIOS_URL_BUILDER={preview:run(preview),reloadPreview:run(reloadPreview),openExternal:run(openExternal),clearAll:run(clearAll),buildPkg:buildPkg,showJson:run(showJson),downloadVaios:run(downloadVaios),downloadHtml:run(downloadHtml),testBuild:run(testBuild)};\\nvar bindings=[['topPreviewBtn',preview],['previewBtn',preview],['topDownloadBtn',downloadVaios],['downloadBtn',downloadVaios],['externalBtn',openExternal],['clearBtn',clearAll],['htmlBtn',downloadHtml],['jsonBtn',showJson],['testBtn',testBuild],['reloadBtn',reloadPreview]];\\nfor(var i=0;i<bindings.length;i++){(function(pair){var b=id(pair[0]);if(b)b.addEventListener('click',run(pair[1],b),false)})(bindings[i])}\\nvar urlInput=id('urlInput');if(urlInput){urlInput.addEventListener('keydown',function(ev){if(ev.key==='Enter')run(preview)(ev)},false);urlInput.addEventListener('change',updateNames,false)}\\nstatus('JS online. Built-in VAiOS system app. Enter a URL, then press Preview or Download. Download .vaios calls the desktop LLM for SVG + metadata. If the local LLM fetch fails, it still downloads a valid package with generated fallback SVG/metadata.','ok')\\n})();\\n</script>\\n</body>\\n</html>\\n\",\n  \"notes\": \"Standalone copy. The fixed desktop includes this as a built-in System app and defaults LLM to http://127.0.0.1:8205.\",\n  \"parentId\": \"\",\n  \"editPrompt\": \"\",\n  \"version\": \"llm-svg-metadata-force-bridge-v2\",\n  \"baseName\": \"URL to VAiOS Builder\",\n  \"createdAt\": \"2026-06-23T01:11:07Z\",\n  \"updatedAt\": \"2026-06-23T01:44:03Z\",\n  \"htmlSize\": 25378\n}",
