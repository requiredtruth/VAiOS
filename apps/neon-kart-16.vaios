{"kind":"vaios-app-package","extension":"vaios","version":1,"createdAt":"2026-06-23T00:28:40Z","desktop":"Virtual Desktop Builder","item":{"id":"neon-kart-16_20260622","type":"app","name":"Neon Kart 16","category1":"Games","category2":"Racing","entryName":"Neon Kart 16","icon":"<svg viewBox=\"0 0 64 64\" xmlns=\"http://www.w3.org/2000/svg\"><defs><linearGradient id=\"g\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\"><stop stop-color=\"#ffef6b\"/><stop offset=\".45\" stop-color=\"#ff5cf4\"/><stop offset=\"1\" stop-color=\"#65f7ff\"/></linearGradient></defs><rect width=\"64\" height=\"64\" rx=\"16\" fill=\"#080912\"/><path d=\"M7 45c10-16 22-23 36-21 7 1 12 4 15 8-12-5-26-2-39 8l-7 5z\" fill=\"url(#g)\" opacity=\".9\"/><path d=\"M17 42h30c5 0 8-3 8-7 0-5-4-10-12-12l-8-8H22l-3 10c-6 2-10 6-10 11 0 4 3 6 8 6z\" fill=\"#ff315d\"/><path d=\"M25 18h9l7 7H23l2-7z\" fill=\"#65f7ff\"/><circle cx=\"20\" cy=\"45\" r=\"8\" fill=\"#11131f\"/><circle cx=\"46\" cy=\"45\" r=\"8\" fill=\"#11131f\"/><circle cx=\"20\" cy=\"45\" r=\"3\" fill=\"#e8f8ff\"/><circle cx=\"46\" cy=\"45\" r=\"3\" fill=\"#e8f8ff\"/><path d=\"M8 10h48M8 14h48\" stroke=\"#fff\" stroke-opacity=\".25\" stroke-width=\"2\"/></svg>","desktopIcon":true,"preferredWidth":1280,"preferredHeight":760,"html":"","htmlSize":37748,"notes":"Original SNES-style pseudo-3D kart racer. Source is stored in files/index.html to avoid localStorage quota duplication.","parentId":"","editPrompt":"","version":1,"baseName":"Neon Kart 16","createdAt":"2026-06-23T00:28:40Z","updatedAt":"2026-06-23T00:28:40Z"},"folder":"/Apps/neon-kart-16","files":{"index.html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no\">\n<title>Neon Kart 16</title>\n<style>\n  :root{--panel:rgba(10,12,30,.72);--line:rgba(255,255,255,.18);--hot:#ffef6b;--cyan:#65f7ff;--pink:#ff5cf4;--green:#86ff8b;}\n  *{box-sizing:border-box; -webkit-tap-highlight-color:transparent;}\n  html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#080912;color:white;font-family:Inter, ui-rounded, system-ui, -apple-system, Segoe UI, sans-serif;}\n  #wrap{position:fixed;inset:0;overflow:hidden;background:radial-gradient(circle at 50% 15%,#213b7e 0,#0b102d 38%,#04050c 100%);}\n  canvas{display:block;width:100%;height:100%;image-rendering:auto;background:#0b1030;}\n  #hud{position:fixed;inset:0;pointer-events:none;text-shadow:0 2px 0 rgba(0,0,0,.45),0 0 12px rgba(0,0,0,.7);}\n  .topbar{position:absolute;top:10px;left:10px;right:10px;display:flex;gap:10px;align-items:flex-start;justify-content:space-between;}\n  .cluster{display:flex;gap:8px;flex-wrap:wrap;align-items:flex-start;}\n  .pill{min-width:92px;padding:9px 11px;border:1px solid var(--line);border-radius:14px;background:linear-gradient(180deg,rgba(255,255,255,.14),rgba(0,0,0,.28));box-shadow:0 8px 30px rgba(0,0,0,.28), inset 0 0 18px rgba(255,255,255,.06);backdrop-filter:blur(8px);}\n  .label{display:block;font-size:10px;letter-spacing:.12em;text-transform:uppercase;opacity:.72;font-weight:800;}\n  .value{font-size:22px;font-weight:950;line-height:1;color:#fff;}\n  .value small{font-size:12px;opacity:.75;}\n  #itemPill .value{color:var(--hot);}\n  #boostbar{position:absolute;left:50%;bottom:108px;transform:translateX(-50%);width:min(430px,62vw);height:13px;border-radius:999px;background:rgba(0,0,0,.45);border:1px solid rgba(255,255,255,.22);overflow:hidden;box-shadow:0 0 26px rgba(0,0,0,.6);}\n  #boostfill{height:100%;width:0;background:linear-gradient(90deg,#4bf0ff,#fff66b,#ff54f8);box-shadow:0 0 20px rgba(255,255,255,.75);}\n  #message{position:absolute;left:50%;top:18%;transform:translateX(-50%);text-align:center;font-weight:1000;font-size:clamp(26px,6vw,74px);letter-spacing:.03em;color:white;text-shadow:0 6px 0 rgba(0,0,0,.38),0 0 34px rgba(101,247,255,.9);white-space:nowrap;}\n  #submsg{display:block;margin-top:6px;font-size:clamp(12px,2vw,18px);font-weight:850;letter-spacing:.12em;text-transform:uppercase;color:#dff;opacity:.9;text-shadow:0 0 18px rgba(0,0,0,.9);}\n  #menu{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;background:radial-gradient(circle at 50% 18%,rgba(90,30,220,.20),rgba(0,0,0,.66) 62%,rgba(0,0,0,.82));z-index:5;color:white;}\n  .card{width:min(960px,94vw);max-height:94vh;overflow:auto;border:1px solid rgba(255,255,255,.22);border-radius:28px;background:linear-gradient(180deg,rgba(20,24,56,.88),rgba(5,7,16,.90));box-shadow:0 24px 80px rgba(0,0,0,.58),inset 0 0 60px rgba(101,247,255,.08);padding:22px;}\n  .title{font-size:clamp(38px,8vw,90px);line-height:.86;margin:8px 0 4px;font-weight:1000;letter-spacing:-.06em;text-transform:uppercase;background:linear-gradient(180deg,#fff,#ffef6b 28%,#ff5cf4 58%,#65f7ff);-webkit-background-clip:text;background-clip:text;color:transparent;filter:drop-shadow(0 7px 0 rgba(0,0,0,.35)) drop-shadow(0 0 20px rgba(255,92,244,.42));}\n  .subtitle{font-size:15px;letter-spacing:.18em;text-transform:uppercase;opacity:.8;margin-bottom:18px;font-weight:900;}\n  .grid{display:grid;grid-template-columns:1.2fr .8fr;gap:16px;}\n  .panel{border:1px solid rgba(255,255,255,.16);border-radius:22px;background:rgba(255,255,255,.055);padding:14px;box-shadow:inset 0 0 20px rgba(255,255,255,.035);}\n  .tracks{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;}\n  .track{min-height:118px;border:1px solid rgba(255,255,255,.18);border-radius:18px;padding:10px;background:linear-gradient(180deg,rgba(255,255,255,.10),rgba(255,255,255,.03));cursor:pointer;position:relative;overflow:hidden;}\n  .track:before{content:\"\";position:absolute;inset:auto -18px -30px -18px;height:68px;background:repeating-linear-gradient(90deg,rgba(255,255,255,.22) 0 18px,transparent 18px 34px);transform:skewY(-9deg);opacity:.24;}\n  .track.active{outline:2px solid var(--hot);box-shadow:0 0 30px rgba(255,239,107,.22),inset 0 0 20px rgba(255,239,107,.10);}\n  .track b{position:relative;display:block;font-size:17px;z-index:1;}\n  .track span{position:relative;display:block;margin-top:5px;font-size:12px;line-height:1.25;opacity:.75;z-index:1;}\n  .track em{position:absolute;right:10px;bottom:8px;font-style:normal;font-size:26px;z-index:1;}\n  .btnrow{display:flex;gap:10px;flex-wrap:wrap;margin-top:14px;}\n  button{appearance:none;border:0;border-radius:16px;padding:13px 16px;font-weight:1000;color:#081020;background:linear-gradient(180deg,#fffac8,#ffcc39);box-shadow:0 7px 0 #9b5f00,0 14px 28px rgba(0,0,0,.38);cursor:pointer;letter-spacing:.03em;text-transform:uppercase;}\n  button:active{transform:translateY(4px);box-shadow:0 3px 0 #9b5f00,0 8px 20px rgba(0,0,0,.32);}\n  button.secondary{background:linear-gradient(180deg,#a9fbff,#42ddea);box-shadow:0 7px 0 #117987,0 14px 28px rgba(0,0,0,.38);}\n  button.dark{color:white;background:linear-gradient(180deg,#2b315e,#12162f);box-shadow:0 7px 0 #050713,0 14px 28px rgba(0,0,0,.38);border:1px solid rgba(255,255,255,.16);}\n  .keys{display:grid;grid-template-columns:auto 1fr;gap:7px 10px;font-size:13px;align-items:center;}\n  kbd{display:inline-block;min-width:34px;text-align:center;padding:5px 8px;border-radius:8px;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.18);font-weight:950;color:#fff;box-shadow:0 3px 0 rgba(0,0,0,.28);}\n  .note{font-size:13px;opacity:.78;line-height:1.45;margin-top:10px;}\n  #touch{position:fixed;inset:auto 0 0 0;height:116px;display:none;z-index:4;pointer-events:none;padding:10px;}\n  .touchLeft,.touchRight{position:absolute;bottom:10px;display:flex;gap:10px;pointer-events:auto;}\n  .touchLeft{left:10px}.touchRight{right:10px}.tbtn{width:68px;height:68px;border-radius:22px;border:1px solid rgba(255,255,255,.20);background:linear-gradient(180deg,rgba(255,255,255,.22),rgba(0,0,0,.30));backdrop-filter:blur(8px);box-shadow:0 8px 28px rgba(0,0,0,.35),inset 0 0 20px rgba(255,255,255,.06);display:grid;place-items:center;color:white;font-size:22px;font-weight:1000;text-shadow:0 2px 0 rgba(0,0,0,.5);user-select:none;touch-action:none;}\n  .tbtn.wide{width:86px}.tbtn.hot{background:linear-gradient(180deg,rgba(255,239,107,.82),rgba(255,92,244,.52));}.tbtn.blue{background:linear-gradient(180deg,rgba(101,247,255,.72),rgba(50,100,255,.42));}\n  #scan{position:fixed;inset:0;pointer-events:none;z-index:6;background:linear-gradient(rgba(255,255,255,.035) 50%,rgba(0,0,0,.035) 50%);background-size:100% 4px;mix-blend-mode:soft-light;opacity:.35;}\n  #corner{position:absolute;right:12px;top:104px;width:170px;height:170px;border-radius:20px;background:rgba(0,0,0,.33);border:1px solid rgba(255,255,255,.17);box-shadow:inset 0 0 28px rgba(101,247,255,.08),0 10px 30px rgba(0,0,0,.35);}\n  #minimap{width:100%;height:100%;display:block;}\n  @media (max-width:780px){.grid{grid-template-columns:1fr}.tracks{grid-template-columns:1fr}.card{padding:16px}.pill{min-width:76px;padding:8px}.value{font-size:18px}#corner{width:118px;height:118px;top:92px}.topbar{gap:6px}.cluster{gap:6px}#touch{display:block}.subtitle{font-size:12px}.panel.controls{display:none}}\n</style>\n</head>\n<body>\n<div id=\"wrap\"><canvas id=\"game\"></canvas></div>\n<div id=\"hud\" aria-hidden=\"true\">\n  <div class=\"topbar\">\n    <div class=\"cluster\">\n      <div class=\"pill\"><span class=\"label\">Speed</span><span class=\"value\" id=\"speed\">0</span></div>\n      <div class=\"pill\"><span class=\"label\">Lap</span><span class=\"value\" id=\"lap\">1<small>/3</small></span></div>\n      <div class=\"pill\"><span class=\"label\">Rank</span><span class=\"value\" id=\"rank\">8th</span></div>\n      <div class=\"pill\" id=\"itemPill\"><span class=\"label\">Item</span><span class=\"value\" id=\"item\">—</span></div>\n    </div>\n    <div class=\"cluster\">\n      <div class=\"pill\"><span class=\"label\">Time</span><span class=\"value\" id=\"time\">0:00.00</span></div>\n      <div class=\"pill\"><span class=\"label\">Track</span><span class=\"value\" id=\"trackName\" style=\"font-size:15px;line-height:1.15\">Neon Harbor</span></div>\n    </div>\n  </div>\n  <div id=\"corner\"><canvas id=\"minimap\"></canvas></div>\n  <div id=\"message\"></div>\n  <div id=\"boostbar\"><div id=\"boostfill\"></div></div>\n</div>\n<div id=\"touch\">\n  <div class=\"touchLeft\"><div class=\"tbtn\" data-key=\"left\">◀</div><div class=\"tbtn\" data-key=\"right\">▶</div></div>\n  <div class=\"touchRight\"><div class=\"tbtn blue\" data-key=\"drift\">DR</div><div class=\"tbtn\" data-key=\"brake\">BR</div><div class=\"tbtn hot wide\" data-key=\"gas\">GAS</div><div class=\"tbtn hot\" data-key=\"item\">★</div></div>\n</div>\n<div id=\"menu\">\n  <div class=\"card\">\n    <div class=\"title\">Neon Kart 16</div>\n    <div class=\"subtitle\">Original SNES-style pseudo‑3D kart racer · no external assets · VAiOS ready</div>\n    <div class=\"grid\">\n      <div class=\"panel\">\n        <b style=\"font-size:18px;letter-spacing:.08em;text-transform:uppercase\">Choose Circuit</b>\n        <div class=\"tracks\" id=\"trackCards\"></div>\n        <div class=\"btnrow\">\n          <button id=\"startBtn\">Start Race</button>\n          <button class=\"secondary\" id=\"practiceBtn\">Practice Lap</button>\n          <button class=\"dark\" id=\"fullBtn\">Fullscreen</button>\n        </div>\n        <div class=\"note\">Race three laps against seven AI karts. Drift through turns, charge sparks, grab item boxes, and use turbo at the right time. Mobile buttons appear automatically on small screens.</div>\n      </div>\n      <div class=\"panel controls\">\n        <b style=\"font-size:18px;letter-spacing:.08em;text-transform:uppercase\">Controls</b>\n        <div class=\"keys\" style=\"margin-top:12px\">\n          <kbd>↑</kbd><span>Accelerate</span>\n          <kbd>↓</kbd><span>Brake / reverse</span>\n          <kbd>←</kbd><span>Steer left</span>\n          <kbd>→</kbd><span>Steer right</span>\n          <kbd>Shift</kbd><span>Hold while turning to drift</span>\n          <kbd>Space</kbd><span>Use item</span>\n          <kbd>P</kbd><span>Pause / resume</span>\n          <kbd>Enter</kbd><span>Start / restart from menu</span>\n        </div>\n        <div class=\"note\">Tip: release drift after the boost meter glows to launch a mini‑turbo. Off-road grass slows you hard unless shielded or boosting.</div>\n      </div>\n    </div>\n  </div>\n</div>\n<div id=\"scan\"></div>\n<script>\n(() => {\n'use strict';\n\nconst canvas = document.getElementById('game');\nconst ctx = canvas.getContext('2d', { alpha:false });\nconst mapCanvas = document.getElementById('minimap');\nconst mapCtx = mapCanvas.getContext('2d');\nconst $ = id => document.getElementById(id);\n\nconst ui = {\n  speed: $('speed'), lap: $('lap'), rank: $('rank'), item: $('item'), time: $('time'),\n  trackName: $('trackName'), menu: $('menu'), message: $('message'), boost: $('boostfill'), cards: $('trackCards')\n};\n\nlet W=1,H=1, DPR=1;\nfunction resize(){\n  DPR = Math.min(2, Math.max(1, window.devicePixelRatio || 1));\n  W = Math.floor(innerWidth * DPR); H = Math.floor(innerHeight * DPR);\n  canvas.width=W; canvas.height=H;\n  mapCanvas.width = Math.floor(mapCanvas.clientWidth * DPR);\n  mapCanvas.height = Math.floor(mapCanvas.clientHeight * DPR);\n}\naddEventListener('resize', resize, {passive:true}); resize();\n\nconst roadWidth = 2200;\nconst segmentLength = 120;\nconst rumbleLength = 4;\nconst drawDistance = 260;\nconst cameraHeight = 920;\nconst cameraDepth = 1 / Math.tan((82 * Math.PI / 180) / 2);\nconst playerZ = cameraHeight * cameraDepth;\nconst lanes = 3;\nconst maxSpeedBase = segmentLength * 84;\nconst accel = maxSpeedBase / 3.4;\nconst braking = -maxSpeedBase;\nconst decel = -maxSpeedBase / 5.6;\nconst offRoadDecel = -maxSpeedBase / 2.1;\nconst offRoadLimit = maxSpeedBase / 3.4;\nconst centrifugal = 0.34;\nconst colors = {\n  light: {grass:'#2bb05a', grass2:'#1c8f48', rumble:'#f9f1d6', road:'#676b7f', lane:'#d9d9e8'},\n  dark:  {grass:'#23994f', grass2:'#13733b', rumble:'#f15065', road:'#565a6f', lane:'#adb0c6'},\n  snow1: {grass:'#c8f5ff', grass2:'#8edbe9', rumble:'#f94f84', road:'#6c78a0', lane:'#e8fbff'},\n  snow2: {grass:'#b1e5ef', grass2:'#78c8dc', rumble:'#ffffff', road:'#566887', lane:'#d9fcff'},\n  lava1: {grass:'#4e1b28', grass2:'#2d1020', rumble:'#ffca3a', road:'#503d52', lane:'#ffa8f6'},\n  lava2: {grass:'#3b1220', grass2:'#220a16', rumble:'#ff4d2e', road:'#47334a', lane:'#ffdc75'}\n};\n\nconst tracks = [\n  {name:'Neon Harbor', icon:'🌉', vibe:'blue city lights, smooth bends', sky:['#68d7ff','#7b5cff','#101336'], palette:['light','dark'], plan:[[30,40,30,0,0],[20,50,25,0.8,22],[16,46,20,-1.15,-16],[22,60,24,0.35,0],[18,48,24,1.35,34],[20,34,20,-0.8,-24],[30,70,40,0,8]]},\n  {name:'Sugar Rush Alps', icon:'❄️', vibe:'icy hills and candy guardrails', sky:['#d8ffff','#91a7ff','#1b2149'], palette:['snow1','snow2'], plan:[[24,42,28,0,30],[12,46,22,-1.35,44],[16,32,18,1.55,-52],[20,58,22,0.4,0],[16,44,20,-.95,38],[18,55,22,1.05,-28],[30,64,34,0,-10]]},\n  {name:'Lava Disco', icon:'🌋', vibe:'hard curves, glowing lava rails', sky:['#ff9a4a','#b22b77','#130719'], palette:['lava1','lava2'], plan:[[22,36,20,0,0],[12,44,18,1.65,26],[10,28,18,-1.8,-32],[18,54,20,.65,44],[12,38,18,-1.3,-18],[16,46,22,1.1,0],[26,72,34,0,-20]]}\n];\n\nlet selectedTrack = 0;\ntracks.forEach((t,i)=>{\n  const el=document.createElement('div'); el.className='track'+(i===0?' active':'');\n  el.innerHTML='<b>'+t.name+'</b><span>'+t.vibe+'</span><em>'+t.icon+'</em>';\n  el.onclick=()=>{selectedTrack=i; document.querySelectorAll('.track').forEach((e,n)=>e.classList.toggle('active', n===i)); drawMiniMap(true);};\n  ui.cards.appendChild(el);\n});\n\nlet segments=[], trackLength=1, routePoints=[];\nfunction easeIn(a,b,p){return a+(b-a)*p*p;}\nfunction easeOut(a,b,p){return a+(b-a)*(1-(1-p)*(1-p));}\nfunction easeInOut(a,b,p){return a+(b-a)*((-Math.cos(p*Math.PI)/2)+.5);}\nfunction percentRemaining(n,total){return (n%total)/total;}\nfunction interpolate(a,b,p){return a+(b-a)*p;}\nfunction increase(start, increment, max){let r=start+increment; while(r>=max) r-=max; while(r<0) r+=max; return r;}\nfunction findSegment(z){return segments[Math.floor(z/segmentLength)%segments.length];}\nfunction ordinal(n){return n===1?'1st':n===2?'2nd':n===3?'3rd':n+'th';}\nfunction fmt(t){const m=Math.floor(t/60), s=Math.floor(t%60), c=Math.floor((t%1)*100); return m+':'+String(s).padStart(2,'0')+'.'+String(c).padStart(2,'0');}\n\nfunction makePoint(z,y){return {world:{x:0,y,z},camera:{},screen:{}};}\nfunction addSegment(curve, y, palette){\n  const n=segments.length;\n  const colName = palette[Math.floor(n/rumbleLength)%2];\n  segments.push({\n    index:n, curve, color:colors[colName], clip:0,\n    p1:makePoint(n*segmentLength, lastY), p2:makePoint((n+1)*segmentLength, y),\n    pickups:[], hazards:[]\n  });\n  lastY = y;\n}\nlet lastY = 0;\nfunction addRoad(enter, hold, leave, curve, hill, palette){\n  const startY=lastY, endY=startY+(hill*segmentLength);\n  const total=enter+hold+leave;\n  for(let n=0;n<enter;n++) addSegment(easeIn(0,curve,n/enter), easeInOut(startY,endY,n/total), palette);\n  for(let n=0;n<hold;n++) addSegment(curve, easeInOut(startY,endY,(enter+n)/total), palette);\n  for(let n=0;n<leave;n++) addSegment(easeOut(curve,0,n/leave), easeInOut(startY,endY,(enter+hold+n)/total), palette);\n}\nfunction resetRoad(track){\n  segments=[]; lastY=0; routePoints=[];\n  for(const p of track.plan) addRoad(p[0],p[1],p[2],p[3],p[4],track.palette);\n  addRoad(24,45,24,0,0,track.palette);\n  trackLength=segments.length*segmentLength;\n  for(let i=30;i<segments.length-20;i+=42){\n    const lanes=[-.55,0,.55];\n    const offset=lanes[(i/42|0)%3];\n    segments[i].pickups.push({offset, type:'box', taken:false, glow:Math.random()*6.28});\n    if(i%126===0){ segments[i+8]?.pickups.push({offset:-offset || .55, type:'coin', taken:false, glow:Math.random()*6.28}); }\n  }\n  // map points from accumulated curve\n  let heading=0, x=0, y=0;\n  for(let i=0;i<segments.length;i+=3){\n    const s=segments[i]; heading += s.curve * 0.018; x += Math.sin(heading)*7; y -= Math.cos(heading)*7; routePoints.push({x,y,i});\n  }\n}\n\nconst keys = Object.create(null);\naddEventListener('keydown', e=>{\n  const k=e.key.toLowerCase(); keys[k]=true;\n  if(['arrowup','arrowdown','arrowleft','arrowright',' '].includes(k)) e.preventDefault();\n  if(k==='enter' && (state==='menu'||state==='finish')) startRace(false);\n  if(k==='p' && (state==='playing'||state==='paused')) togglePause();\n  if(k==='escape' && state==='playing') togglePause();\n  if(k===' ' && state==='playing') useItem();\n});\naddEventListener('keyup', e=>{keys[e.key.toLowerCase()]=false;});\n\ndocument.querySelectorAll('.tbtn').forEach(btn=>{\n  const key=btn.dataset.key;\n  const down=e=>{e.preventDefault(); touch[key]=true; if(key==='item') useItem();};\n  const up=e=>{e.preventDefault(); touch[key]=false;};\n  btn.addEventListener('pointerdown', down); btn.addEventListener('pointerup', up); btn.addEventListener('pointercancel', up); btn.addEventListener('pointerleave', up);\n});\nlet touch={left:false,right:false,gas:false,brake:false,drift:false,item:false};\n\nlet state='menu', practice=false, raceTime=0, countdown=0;\nlet playerX=0, speed=0, progress=0, lap=1, finished=false, finishTime=0;\nlet boostTimer=0, shieldTimer=0, drift=0, driftSide=0, sparks=0, item=null, shake=0, flash=0, coins=0;\nlet opponents=[], particles=[], hazards=[];\nlet audio=null, musicStep=0, musicTimer=0;\nconst kartColors=['#ff4b5f','#52e0ff','#ffdf58','#7dff6b','#ff83e4','#ffa94a','#b29cff'];\n\nfunction newOpponent(i){return {name:['Rex','Byte','Mox','Juno','Zip','Vega','Lux'][i], progress:-(i+1)*260, offset:((i%3)-1)*.48, target:0, speed:maxSpeedBase*(.71+i*.025+Math.random()*.025), color:kartColors[i], seed:Math.random()*99, hit:0, rank:8};}\nfunction resetRace(){\n  resetRoad(tracks[selectedTrack]);\n  progress=0; playerX=0; speed=0; raceTime=0; lap=1; finished=false; finishTime=0; boostTimer=0; shieldTimer=0; drift=0; driftSide=0; sparks=0; item=null; shake=0; flash=0; coins=0;\n  opponents=Array.from({length:7},(_,i)=>newOpponent(i)); particles=[]; hazards=[]; countdown=3.2; state='playing';\n  ui.menu.style.display='none'; ui.trackName.textContent=tracks[selectedTrack].name; ui.item.textContent='—';\n  drawMiniMap(true);\n}\nfunction startRace(prac){practice=prac; unlockAudio(); resetRace();}\nfunction togglePause(){ if(state==='playing'){state='paused'; ui.menu.style.display='flex'; $('startBtn').textContent='Resume Race';} else if(state==='paused'){state='playing'; ui.menu.style.display='none'; $('startBtn').textContent='Start Race';}}\n$('startBtn').onclick=()=>{ if(state==='paused') togglePause(); else startRace(false); };\n$('practiceBtn').onclick=()=>startRace(true);\n$('fullBtn').onclick=()=>{const el=document.documentElement; if(!document.fullscreenElement && el.requestFullscreen) el.requestFullscreen();};\n\nfunction unlockAudio(){\n  if(audio) return;\n  try{ audio = new (window.AudioContext||window.webkitAudioContext)(); }catch(e){ audio=null; return; }\n}\nfunction beep(freq=440,dur=.08,type='square',gain=.035){\n  if(!audio) return; const now=audio.currentTime; const o=audio.createOscillator(); const g=audio.createGain();\n  o.type=type; o.frequency.setValueAtTime(freq,now); g.gain.setValueAtTime(gain,now); g.gain.exponentialRampToValueAtTime(.0001,now+dur);\n  o.connect(g).connect(audio.destination); o.start(now); o.stop(now+dur+.02);\n}\nfunction music(dt){\n  if(!audio || state!=='playing' || countdown>0) return;\n  musicTimer-=dt; if(musicTimer>0) return; musicTimer=.145;\n  const scale=[392,494,587,740,659,587,494,523,659,784,988,880,784,659,587,494];\n  const f=scale[musicStep++%scale.length]*(boostTimer>0?1.02:1);\n  beep(f,.05,'square',.018);\n}\n\nfunction useItem(){\n  if(!item || state!=='playing' || countdown>0) return;\n  if(item==='BOOST'){boostTimer=2.2; flash=.45; beep(880,.1,'sawtooth',.06); spawnBurst('#ffef6b',18);}\n  if(item==='SHIELD'){shieldTimer=5.0; beep(660,.15,'triangle',.05);}\n  if(item==='SPARK'){\n    const ahead=opponents.filter(o=>o.progress>progress-200).sort((a,b)=>a.progress-b.progress)[0] || opponents[0];\n    if(ahead){ahead.progress-=560; ahead.hit=.8; spawnWorldBurst(ahead.progress, ahead.offset, '#65f7ff', 22);}\n    beep(1220,.18,'square',.05);\n  }\n  if(item==='OIL'){\n    hazards.push({progress:progress-230, z:increase((progress-230)%trackLength,0,trackLength), offset:playerX, life:18});\n    beep(180,.12,'sawtooth',.05);\n  }\n  item=null; ui.item.textContent='—';\n}\nfunction randomItem(){ const bag=['BOOST','BOOST','SHIELD','SPARK','OIL']; return bag[Math.floor(Math.random()*bag.length)]; }\n\nfunction update(dt){\n  music(dt);\n  if(state!=='playing') return;\n  const segment=findSegment(increase(progress,0,trackLength));\n  const speedPercent=speed/maxSpeedBase;\n  if(countdown>0){ countdown-=dt; speed=0; if(countdown<=0) beep(740,.14,'square',.06); return; }\n  raceTime+=dt; flash=Math.max(0,flash-dt); shake=Math.max(0,shake-dt); shieldTimer=Math.max(0,shieldTimer-dt); boostTimer=Math.max(0,boostTimer-dt);\n  const left=keys.arrowleft||keys.a||touch.left, right=keys.arrowright||keys.d||touch.right;\n  const gas=keys.arrowup||keys.w||touch.gas, brakeKey=keys.arrowdown||keys.s||touch.brake;\n  const driftKey=keys.shift||keys.control||touch.drift;\n  speed += (gas?accel:(brakeKey?braking:decel))*dt;\n  if(boostTimer>0) speed += accel*1.7*dt;\n  const maxSpeed=maxSpeedBase*(boostTimer>0?1.22:1);\n  speed=Math.max(0,Math.min(maxSpeed,speed));\n  const steer=dt*2.7*speedPercent*(boostTimer>0?1.08:1);\n  if(left) playerX-=steer; if(right) playerX+=steer;\n  playerX -= speedPercent * segment.curve * centrifugal * dt * 2.2;\n  const drifting = driftKey && (left||right) && speedPercent>.33;\n  if(drifting){\n    const side=left?-1:1; if(driftSide && driftSide!==side){drift=.15; sparks=0;} driftSide=side; drift+=dt; sparks=Math.min(1,drift/1.4); playerX += side*dt*.18; spawnTire(side);\n  } else {\n    if(drift>.85 && speedPercent>.35){ boostTimer=Math.max(boostTimer, drift>1.55?1.25:.62); flash=.22; beep(drift>1.55?980:720,.09,'square',.05); spawnBurst(drift>1.55?'#ff5cf4':'#65f7ff',14); }\n    drift=0; driftSide=0; sparks=0;\n  }\n  if(Math.abs(playerX)>1.04 && boostTimer<=0 && shieldTimer<=0){ speed += offRoadDecel*dt; if(speed>offRoadLimit) speed=offRoadLimit; spawnGrass(); }\n  if(Math.abs(playerX)>1.8){ playerX=Math.sign(playerX)*1.8; speed*=.94; shake=.08; }\n  const lastProgress=progress;\n  progress += speed*dt;\n  const oldLap=Math.floor(lastProgress/trackLength)+1;\n  lap=Math.floor(progress/trackLength)+1;\n  if(lap!==oldLap && lap<=3){beep(880,.09); beep(1175,.12);}\n  if((practice && lap>1) || (!practice && lap>3)){ finishRace(); }\n  updateOpponents(dt);\n  collectItems(); collideOpponents(dt); collideHazards(dt); updateParticles(dt);\n}\nfunction finishRace(){ if(finished) return; finished=true; finishTime=raceTime; state='finish'; ui.menu.style.display='flex'; $('startBtn').textContent='Race Again'; ui.message.innerHTML='FINISH<span id=\"submsg\">Time '+fmt(finishTime)+' · '+ordinal(rank())+' place</span>'; beep(1046,.16); setTimeout(()=>beep(1318,.18),130); }\nfunction rank(){ let r=1; for(const o of opponents) if(o.progress>progress) r++; return r; }\n\nfunction updateOpponents(dt){\n  for(const o of opponents){\n    const pos=increase(o.progress,0,trackLength), seg=findSegment(pos);\n    o.target=Math.sin(o.progress*.0009+o.seed)*.55 - seg.curve*.22;\n    o.offset += (o.target-o.offset)*dt*1.15;\n    let rubber = 1;\n    const gap=o.progress-progress;\n    if(gap<-2200) rubber=1.18; if(gap>3200) rubber=.92;\n    if(o.hit>0){o.hit-=dt; rubber*=.55;}\n    o.progress += o.speed*rubber*dt;\n    for(const h of hazards){ if(Math.abs(o.progress-h.progress)<95 && Math.abs(o.offset-h.offset)<.28){o.hit=.7; h.life=0; spawnWorldBurst(o.progress,o.offset,'#111',12);}}\n  }\n  hazards=hazards.filter(h=>(h.life-=dt)>0);\n}\nfunction collectItems(){\n  const pos=increase(progress+playerZ*.18,0,trackLength), seg=findSegment(pos);\n  for(const p of seg.pickups){\n    if(!p.taken && Math.abs(playerX-p.offset)<.22){\n      p.taken=true; if(p.type==='coin'){coins++; boostTimer=Math.max(boostTimer,.22); beep(1318,.07,'square',.04); spawnBurst('#ffef6b',8);} else if(!item){item=randomItem(); ui.item.textContent=item; beep(988,.08,'square',.05);}\n    }\n  }\n}\nfunction collideOpponents(dt){\n  if(shieldTimer>0) return;\n  for(const o of opponents){\n    if(Math.abs(o.progress-progress-playerZ*.18)<145 && Math.abs(o.offset-playerX)<.28){\n      speed*=.72; o.hit=.25; shake=.18; spawnBurst('#ffffff',12); beep(90,.12,'sawtooth',.06);\n      playerX += (playerX-o.offset)*dt*3;\n    }\n  }\n}\nfunction collideHazards(dt){\n  if(shieldTimer>0) return;\n  for(const h of hazards){ if(Math.abs(h.progress-progress)<125 && Math.abs(h.offset-playerX)<.27){ speed*=.55; shake=.23; h.life=0; spawnBurst('#1b1020',12); beep(130,.15,'sawtooth',.06); }}\n}\nfunction updateParticles(dt){ particles=particles.filter(p=>{p.t-=dt; p.x+=p.vx*dt; p.y+=p.vy*dt; p.vy+=220*dt; return p.t>0;}); }\nfunction spawnBurst(color,n){ for(let i=0;i<n;i++) particles.push({screen:true,x:W/2+(Math.random()-.5)*90*DPR,y:H*.75+(Math.random()-.5)*40*DPR,vx:(Math.random()-.5)*420*DPR,vy:(Math.random()-.9)*360*DPR,t:.45+Math.random()*.35,c:color,s:2+Math.random()*4}); }\nfunction spawnWorldBurst(prog, offset, color, n){ for(let i=0;i<n;i++) particles.push({world:true,progress:prog+(Math.random()-.5)*80,offset:offset+(Math.random()-.5)*.25,t:.6,c:color,s:2+Math.random()*4}); }\nfunction spawnTire(side){ if(Math.random()<.55) particles.push({screen:true,x:W/2+side*70*DPR+(Math.random()-.5)*20,y:H*.82+(Math.random()-.5)*8,vx:side*-80*DPR+(Math.random()-.5)*50,vy:-40*DPR-Math.random()*50,t:.25,c:sparks>.8?'#ff5cf4':'#65f7ff',s:2+Math.random()*3}); }\nfunction spawnGrass(){ if(Math.random()<.45) particles.push({screen:true,x:W/2+Math.sign(playerX)*(150+Math.random()*120)*DPR,y:H*.82+Math.random()*30,vx:(Math.random()-.5)*130,vy:-100-Math.random()*60,t:.45,c:'#8cff7a',s:2+Math.random()*3}); }\n\nfunction project(p, cameraX, cameraY, cameraZ, looped){\n  p.camera.x = (p.world.x||0) - cameraX;\n  p.camera.y = p.world.y - cameraY;\n  p.camera.z = (p.world.z + (looped?trackLength:0)) - cameraZ;\n  p.screen.scale = cameraDepth / Math.max(1,p.camera.z);\n  p.screen.x = Math.round((W/2) + (p.screen.scale * p.camera.x * W/2));\n  p.screen.y = Math.round((H/2) - (p.screen.scale * p.camera.y * H/2));\n  p.screen.w = Math.round(p.screen.scale * roadWidth * W/2);\n}\nfunction drawQuad(color,x1,y1,w1,x2,y2,w2){\n  ctx.fillStyle=color; ctx.beginPath(); ctx.moveTo(x1-w1,y1); ctx.lineTo(x2-w2,y2); ctx.lineTo(x2+w2,y2); ctx.lineTo(x1+w1,y1); ctx.closePath(); ctx.fill();\n}\nfunction drawRoadSegment(seg){\n  const p1=seg.p1.screen,p2=seg.p2.screen, c=seg.color;\n  ctx.fillStyle=c.grass; ctx.fillRect(0,p2.y,W,p1.y-p2.y+1);\n  const stripe = Math.floor(seg.index/rumbleLength)%2===0;\n  if(stripe){ ctx.fillStyle=c.grass2; for(let x=-80*DPR;x<W;x+=190*DPR){ctx.fillRect(x,p2.y,54*DPR,p1.y-p2.y+2);} }\n  drawQuad(c.rumble,p1.x,p1.y,p1.w*1.18,p2.x,p2.y,p2.w*1.18);\n  drawQuad(c.road,p1.x,p1.y,p1.w,p2.x,p2.y,p2.w);\n  if(stripe){\n    const lanew1=p1.w*2/lanes, lanew2=p2.w*2/lanes;\n    for(let lane=1; lane<lanes; lane++){\n      const l1=p1.x-p1.w+lanew1*lane, l2=p2.x-p2.w+lanew2*lane;\n      drawQuad(c.lane,l1,p1.y,Math.max(1,p1.w*.012),l2,p2.y,Math.max(1,p2.w*.012));\n    }\n  }\n}\nfunction drawBackground(track, baseCurve){\n  const sky=track.sky;\n  const g=ctx.createLinearGradient(0,0,0,H*.62); g.addColorStop(0,sky[0]); g.addColorStop(.43,sky[1]); g.addColorStop(1,sky[2]); ctx.fillStyle=g; ctx.fillRect(0,0,W,H);\n  const sunX=W*(.76+Math.sin(raceTime*.08)*.02), sunY=H*.16;\n  const rg=ctx.createRadialGradient(sunX,sunY,8*DPR,sunX,sunY,150*DPR); rg.addColorStop(0,'rgba(255,255,224,.95)'); rg.addColorStop(.25,'rgba(255,190,90,.55)'); rg.addColorStop(1,'rgba(255,100,240,0)'); ctx.fillStyle=rg; ctx.fillRect(0,0,W,H*.55);\n  const par=((progress*.00008 + playerX*.035 + baseCurve*.08)%1)*W;\n  drawMountains(H*.36, par*.35, '#1a2458', .85);\n  drawMountains(H*.43, par*.55+300*DPR, '#12183d', .98);\n  // city / crystals\n  ctx.save(); ctx.globalAlpha=.55; ctx.fillStyle='rgba(180,245,255,.72)';\n  for(let i=0;i<32;i++){ const x=(i*97*DPR-par*.72)%(W+120*DPR)-60*DPR; const h=(28+((i*37)%80))*DPR; ctx.fillRect(x,H*.45-h,22*DPR,h); if(i%3===0) ctx.fillStyle='rgba(255,92,244,.65)'; else ctx.fillStyle='rgba(180,245,255,.72)'; }\n  ctx.restore();\n}\nfunction drawMountains(y, offset, color, alpha){\n  ctx.save(); ctx.globalAlpha=alpha; ctx.fillStyle=color; ctx.beginPath(); ctx.moveTo(-120*DPR,y);\n  for(let x=-120*DPR;x<W+160*DPR;x+=90*DPR){ const px=x-((offset%(90*DPR))); const peak=y-(45+((x/90|0)*31%70))*DPR; ctx.lineTo(px+45*DPR,peak); ctx.lineTo(px+90*DPR,y); }\n  ctx.lineTo(W+200*DPR,H*.58); ctx.lineTo(-200*DPR,H*.58); ctx.closePath(); ctx.fill(); ctx.restore();\n}\nfunction drawKart(x,y,size,color,lean=0,player=false,shield=false){\n  ctx.save(); ctx.translate(x,y); ctx.scale(size,size); ctx.rotate(lean*.08);\n  ctx.globalAlpha=player?1:.98;\n  ctx.fillStyle='rgba(0,0,0,.36)'; ctx.beginPath(); ctx.ellipse(0,18,34,10,0,0,Math.PI*2); ctx.fill();\n  if(shield){ ctx.strokeStyle='rgba(101,247,255,.72)'; ctx.lineWidth=4; ctx.beginPath(); ctx.ellipse(0,-10,48,38,0,0,Math.PI*2); ctx.stroke(); }\n  ctx.fillStyle='#101018'; roundRect(-35,-4,20,25,5); ctx.fill(); roundRect(15,-4,20,25,5); ctx.fill();\n  ctx.fillStyle=color; roundRect(-31,-28,62,38,9); ctx.fill();\n  ctx.fillStyle='rgba(255,255,255,.28)'; roundRect(-20,-24,40,12,5); ctx.fill();\n  ctx.fillStyle='#16151f'; roundRect(-15,-42,30,22,8); ctx.fill();\n  ctx.fillStyle='#ffe6b3'; ctx.beginPath(); ctx.arc(0,-47,10,0,Math.PI*2); ctx.fill();\n  ctx.fillStyle=player?'#fff66b':'#eff'; ctx.fillRect(-10,-52,20,5);\n  ctx.fillStyle='rgba(255,255,255,.88)'; ctx.fillRect(-23,-16,46,7);\n  ctx.fillStyle='rgba(0,0,0,.22)'; ctx.fillRect(-27,-1,54,8);\n  ctx.restore();\n}\nfunction roundRect(x,y,w,h,r){ ctx.beginPath(); ctx.moveTo(x+r,y); ctx.arcTo(x+w,y,x+w,y+h,r); ctx.arcTo(x+w,y+h,x,y+h,r); ctx.arcTo(x,y+h,x,y,r); ctx.arcTo(x,y,x+w,y,r); ctx.closePath(); }\nfunction drawPickup(x,y,scale,p,type){\n  ctx.save(); ctx.translate(x,y); ctx.scale(scale,scale); ctx.rotate(Math.sin(raceTime*4+p.glow)*.18);\n  if(type==='coin'){\n    ctx.fillStyle='#ffdf4f'; ctx.beginPath(); ctx.ellipse(0,-10,13,20,0,0,Math.PI*2); ctx.fill(); ctx.fillStyle='#fff4a9'; ctx.fillRect(-3,-24,6,28);\n  } else {\n    ctx.fillStyle='rgba(0,0,0,.25)'; ctx.fillRect(-18,10,36,7);\n    ctx.fillStyle='#65f7ff'; ctx.fillRect(-18,-28,36,36); ctx.fillStyle='#ff5cf4'; ctx.fillRect(-13,-23,26,26); ctx.fillStyle='#fff'; ctx.font='900 28px sans-serif'; ctx.textAlign='center'; ctx.fillText('?',0,3);\n  }\n  ctx.restore();\n}\nfunction drawOil(x,y,scale){ ctx.save(); ctx.translate(x,y); ctx.scale(scale,scale); const g=ctx.createRadialGradient(0,0,2,0,0,30); g.addColorStop(0,'rgba(255,92,244,.72)'); g.addColorStop(.35,'rgba(101,247,255,.48)'); g.addColorStop(1,'rgba(0,0,0,.82)'); ctx.fillStyle=g; ctx.beginPath(); ctx.ellipse(0,0,34,15,0,0,Math.PI*2); ctx.fill(); ctx.restore();}\n\nfunction render(){\n  const pos=increase(progress,0,trackLength), base=findSegment(pos), basePercent=percentRemaining(pos,segmentLength);\n  const playerSeg=findSegment(increase(pos+playerZ,0,trackLength));\n  const playerY=interpolate(playerSeg.p1.world.y,playerSeg.p2.world.y,percentRemaining(pos+playerZ,segmentLength));\n  const cameraX=playerX*roadWidth;\n  const cameraY=playerY+cameraHeight;\n  const cameraZ=pos;\n  const shakeX=shake? (Math.random()-.5)*18*DPR : 0, shakeY=shake? (Math.random()-.5)*12*DPR : 0;\n  ctx.save(); ctx.translate(shakeX,shakeY);\n  drawBackground(tracks[selectedTrack],base.curve);\n  let x=0, dx=-(base.curve*basePercent), maxY=H;\n  const visible=[];\n  for(let n=0;n<drawDistance;n++){\n    const seg=segments[(base.index+n)%segments.length]; seg.looped=seg.index<base.index; seg.clip=maxY;\n    seg.p1.world.x=x; seg.p2.world.x=x+dx; x+=dx; dx+=seg.curve;\n    project(seg.p1,cameraX,cameraY,cameraZ,seg.looped); project(seg.p2,cameraX,cameraY,cameraZ,seg.looped);\n    if(seg.p1.camera.z<=cameraDepth || seg.p2.screen.y>=seg.p1.screen.y || seg.p2.screen.y>=maxY) continue;\n    drawRoadSegment(seg); maxY=seg.p2.screen.y; visible.push(seg);\n  }\n  for(let n=visible.length-1;n>=0;n--){\n    const seg=visible[n];\n    for(const p of seg.pickups){ if(!p.taken) drawWorldThing(seg, (seg.index+.35)*segmentLength, p.offset, (x,y,sc)=>drawPickup(x,y,sc,p,p.type)); }\n    for(const h of hazards){ const hz=increase(h.progress,0,trackLength); if(findSegment(hz).index===seg.index) drawWorldThing(seg, hz, h.offset, drawOil); }\n    for(const o of opponents){ const oz=increase(o.progress,0,trackLength); if(findSegment(oz).index===seg.index) drawWorldThing(seg, oz, o.offset, (sx,sy,sc)=>drawKart(sx,sy,sc*.92,o.color,Math.sin(o.progress*.006)*.5,false,false)); }\n  }\n  drawWorldParticles();\n  const lean=(keys.arrowleft||touch.left?-1:0)+(keys.arrowright||touch.right?1:0);\n  drawPlayerKart(lean);\n  drawScreenParticles();\n  if(flash>0){ ctx.fillStyle='rgba(255,255,255,'+(flash*.45)+')'; ctx.fillRect(0,0,W,H); }\n  ctx.restore();\n  drawVignette(); drawHUD(); drawMiniMap(false);\n}\nfunction drawWorldThing(seg, z, offset, fn){\n  const percent=percentRemaining(z,segmentLength);\n  const p1=seg.p1.screen,p2=seg.p2.screen;\n  const scale=interpolate(p1.scale,p2.scale,percent);\n  const sx=interpolate(p1.x,p2.x,percent) + interpolate(p1.w,p2.w,percent)*offset;\n  const sy=interpolate(p1.y,p2.y,percent);\n  const size=Math.max(.08,Math.min(2.2,scale*1150));\n  if(sy<seg.clip+40 && sy>H*.04) fn(sx,sy,size);\n}\nfunction drawWorldParticles(){\n  for(const p of particles){ if(!p.world) continue; const pos=increase(p.progress,0,trackLength), seg=findSegment(pos); if(!seg.p1.screen.scale) continue; const percent=percentRemaining(pos,segmentLength); const sx=interpolate(seg.p1.screen.x,seg.p2.screen.x,percent)+interpolate(seg.p1.screen.w,seg.p2.screen.w,percent)*p.offset; const sy=interpolate(seg.p1.screen.y,seg.p2.screen.y,percent); ctx.globalAlpha=Math.max(0,p.t); ctx.fillStyle=p.c; ctx.beginPath(); ctx.arc(sx,sy,p.s*DPR,0,Math.PI*2); ctx.fill(); ctx.globalAlpha=1; }\n}\nfunction drawScreenParticles(){\n  for(const p of particles){ if(!p.screen) continue; ctx.globalAlpha=Math.max(0,p.t*1.8); ctx.fillStyle=p.c; ctx.beginPath(); ctx.arc(p.x,p.y,p.s*DPR,0,Math.PI*2); ctx.fill(); ctx.globalAlpha=1; }\n}\nfunction drawPlayerKart(lean){\n  const y=H*.84 + Math.sin(raceTime*26)*Math.min(4,speed/maxSpeedBase*4)*DPR;\n  const driftLean=driftSide*.6*sparks;\n  const size=Math.max(1.25,Math.min(2.2,W/760));\n  if(boostTimer>0){\n    const g=ctx.createRadialGradient(W/2,y+8,10,W/2,y+8,140*DPR); g.addColorStop(0,'rgba(255,239,107,.7)'); g.addColorStop(.36,'rgba(255,92,244,.26)'); g.addColorStop(1,'rgba(101,247,255,0)'); ctx.fillStyle=g; ctx.fillRect(W/2-170*DPR,y-110*DPR,340*DPR,220*DPR);\n  }\n  drawKart(W/2 + lean*18*DPR, y, size*DPR, '#ff315d', lean+driftLean, true, shieldTimer>0);\n}\nfunction drawVignette(){\n  const g=ctx.createRadialGradient(W/2,H/2,Math.min(W,H)*.25,W/2,H/2,Math.max(W,H)*.75); g.addColorStop(0,'rgba(0,0,0,0)'); g.addColorStop(1,'rgba(0,0,0,.46)'); ctx.fillStyle=g; ctx.fillRect(0,0,W,H);\n}\nfunction drawHUD(){\n  ui.speed.textContent = Math.round(speed/maxSpeedBase*160);\n  ui.lap.innerHTML = Math.min(lap,practice?1:3)+'<small>/'+(practice?1:3)+'</small>';\n  ui.rank.textContent = ordinal(rank());\n  ui.time.textContent = fmt(raceTime);\n  ui.boost.style.width = Math.round(Math.max(boostTimer/2.2, sparks)*100)+'%';\n  if(state==='playing'){\n    if(countdown>0){ const v=Math.ceil(countdown); ui.message.innerHTML=(v>0?v:'GO!')+'<span id=\"submsg\">'+(v>0?'Get ready':'burn rubber')+'</span>'; }\n    else if(boostTimer>0) ui.message.innerHTML='BOOST<span id=\"submsg\">turbo active</span>';\n    else ui.message.textContent='';\n  }\n}\nfunction drawMiniMap(force){\n  if(!routePoints.length) return;\n  const w=mapCanvas.width,h=mapCanvas.height; if(w<5||h<5) return;\n  mapCtx.clearRect(0,0,w,h);\n  mapCtx.fillStyle='rgba(0,0,0,.24)'; mapCtx.fillRect(0,0,w,h);\n  let minX=Infinity,maxX=-Infinity,minY=Infinity,maxY=-Infinity; for(const p of routePoints){minX=Math.min(minX,p.x);maxX=Math.max(maxX,p.x);minY=Math.min(minY,p.y);maxY=Math.max(maxY,p.y);} const pad=18*DPR, sx=(w-pad*2)/(maxX-minX||1), sy=(h-pad*2)/(maxY-minY||1), s=Math.min(sx,sy);\n  function tx(p){return pad+(p.x-minX)*s+(w-pad*2-(maxX-minX)*s)/2;} function ty(p){return pad+(p.y-minY)*s+(h-pad*2-(maxY-minY)*s)/2;}\n  mapCtx.strokeStyle='rgba(255,255,255,.32)'; mapCtx.lineWidth=11*DPR; mapCtx.lineCap='round'; mapCtx.lineJoin='round'; mapCtx.beginPath(); routePoints.forEach((p,i)=>{ if(i) mapCtx.lineTo(tx(p),ty(p)); else mapCtx.moveTo(tx(p),ty(p));}); mapCtx.closePath(); mapCtx.stroke();\n  mapCtx.strokeStyle='rgba(101,247,255,.88)'; mapCtx.lineWidth=4*DPR; mapCtx.stroke();\n  const pi=Math.floor((increase(progress,0,trackLength)/trackLength)*routePoints.length)%routePoints.length, pp=routePoints[pi];\n  mapCtx.fillStyle='#ff315d'; mapCtx.beginPath(); mapCtx.arc(tx(pp),ty(pp),6*DPR,0,Math.PI*2); mapCtx.fill(); mapCtx.strokeStyle='white'; mapCtx.lineWidth=2*DPR; mapCtx.stroke();\n  for(const o of opponents){ const oi=Math.floor((increase(o.progress,0,trackLength)/trackLength)*routePoints.length)%routePoints.length, op=routePoints[oi]; mapCtx.fillStyle=o.color; mapCtx.beginPath(); mapCtx.arc(tx(op),ty(op),3.5*DPR,0,Math.PI*2); mapCtx.fill(); }\n}\n\nlet last=performance.now();\nfunction frame(now){ const dt=Math.min(.05,(now-last)/1000); last=now; update(dt); render(); requestAnimationFrame(frame); }\nresetRoad(tracks[selectedTrack]); drawMiniMap(true); requestAnimationFrame(frame);\n})();\n</script>\n</body>\n</html>\n","manifest.json":"{\n  \"name\": \"Neon Kart 16\",\n  \"version\": 1,\n  \"createdAt\": \"2026-06-23T00:28:40Z\",\n  \"entry\": \"index.html\",\n  \"description\": \"Self-contained VAiOS kart racing game.\"\n}","item.json":"{\n  \"id\": \"neon-kart-16_20260622\",\n  \"type\": \"app\",\n  \"name\": \"Neon Kart 16\",\n  \"category1\": \"Games\",\n  \"category2\": \"Racing\",\n  \"entryName\": \"Neon Kart 16\",\n  \"icon\": \"<svg viewBox=\\\"0 0 64 64\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\"><defs><linearGradient id=\\\"g\\\" x1=\\\"0\\\" y1=\\\"0\\\" x2=\\\"1\\\" y2=\\\"1\\\"><stop stop-color=\\\"#ffef6b\\\"/><stop offset=\\\".45\\\" stop-color=\\\"#ff5cf4\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#65f7ff\\\"/></linearGradient></defs><rect width=\\\"64\\\" height=\\\"64\\\" rx=\\\"16\\\" fill=\\\"#080912\\\"/><path d=\\\"M7 45c10-16 22-23 36-21 7 1 12 4 15 8-12-5-26-2-39 8l-7 5z\\\" fill=\\\"url(#g)\\\" opacity=\\\".9\\\"/><path d=\\\"M17 42h30c5 0 8-3 8-7 0-5-4-10-12-12l-8-8H22l-3 10c-6 2-10 6-10 11 0 4 3 6 8 6z\\\" fill=\\\"#ff315d\\\"/><path d=\\\"M25 18h9l7 7H23l2-7z\\\" fill=\\\"#65f7ff\\\"/><circle cx=\\\"20\\\" cy=\\\"45\\\" r=\\\"8\\\" fill=\\\"#11131f\\\"/><circle cx=\\\"46\\\" cy=\\\"45\\\" r=\\\"8\\\" fill=\\\"#11131f\\\"/><circle cx=\\\"20\\\" cy=\\\"45\\\" r=\\\"3\\\" fill=\\\"#e8f8ff\\\"/><circle cx=\\\"46\\\" cy=\\\"45\\\" r=\\\"3\\\" fill=\\\"#e8f8ff\\\"/><path d=\\\"M8 10h48M8 14h48\\\" stroke=\\\"#fff\\\" stroke-opacity=\\\".25\\\" stroke-width=\\\"2\\\"/></svg>\",\n  \"desktopIcon\": true,\n  \"preferredWidth\": 1280,\n  \"preferredHeight\": 760,\n  \"html\": \"\",\n  \"htmlSize\": 37748,\n  \"notes\": \"Original SNES-style pseudo-3D kart racer. Source is stored in files/index.html to avoid localStorage quota duplication.\",\n  \"parentId\": \"\",\n  \"editPrompt\": \"\",\n  \"version\": 1,\n  \"baseName\": \"Neon Kart 16\",\n  \"createdAt\": \"2026-06-23T00:28:40Z\",\n  \"updatedAt\": \"2026-06-23T00:28:40Z\"\n}","readme.txt":"Neon Kart 16 is a self-contained original SNES-style kart racer. Import this .vaios through VAiOS App Manager. Controls: arrows/WASD, Shift drift, Space item, P pause."}}