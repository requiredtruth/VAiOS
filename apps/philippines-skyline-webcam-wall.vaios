  "files": {
    "index.html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<title>Philippines Skyline Webcam Wall</title>\n<style>\n  html, body {\n    width:100%; height:100%; margin:0; overflow:hidden;\n    background:#000; color:#eafff8;\n    font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;\n  }\n  #grid {\n    position:fixed; inset:0;\n    display:grid;\n    grid-template-columns: repeat(var(--cols, 6), minmax(0, 1fr));\n    grid-template-rows: repeat(var(--rows, 4), minmax(0, 1fr));\n    gap:0; background:#000;\n  }\n  .tile {\n    position:relative;\n    overflow:hidden;\n    background:#020506;\n    outline:1px solid rgba(255,255,255,.08);\n    min-width:0; min-height:0;\n  }\n  .tile iframe {\n    position:absolute;\n    border:0;\n    background:#000;\n    width:100%;\n    height:100%;\n    inset:0;\n  }\n  .tile.crop iframe {\n    width:130%;\n    height:135%;\n    left:50%;\n    top:-14%;\n    transform:translateX(-50%);\n  }\n  .label {\n    position:absolute;\n    left:6px;\n    top:5px;\n    z-index:3;\n    max-width:calc(100% - 42px);\n    padding:3px 7px 4px;\n    border-radius:7px;\n    font-size:11px;\n    line-height:1.1;\n    letter-spacing:.02em;\n    color:rgba(255,255,255,.92);\n    background:rgba(0,0,0,.42);\n    box-shadow:0 1px 10px rgba(0,0,0,.35);\n    white-space:nowrap;\n    overflow:hidden;\n    text-overflow:ellipsis;\n    pointer-events:none;\n    backdrop-filter:blur(3px);\n  }\n  .loading {\n    position:absolute; inset:0;\n    display:grid; place-items:center;\n    color:rgba(255,255,255,.42);\n    font-size:12px;\n    letter-spacing:.08em;\n    text-transform:uppercase;\n    pointer-events:none;\n  }\n  #fs {\n    position:fixed;\n    right:5px; top:5px;\n    z-index:10;\n    width:22px; height:22px;\n    border:1px solid rgba(255,255,255,.22);\n    border-radius:5px;\n    background:rgba(0,0,0,.35);\n    color:rgba(255,255,255,.8);\n    font-size:12px;\n    line-height:20px;\n    padding:0;\n    cursor:pointer;\n    backdrop-filter:blur(4px);\n  }\n  #fs:hover { background:rgba(0,0,0,.62); color:white; }\n  .tile.focus { position:fixed; inset:0; z-index:8; outline:none; }\n  .tile.focus iframe { width:100%; height:100%; left:0; top:0; transform:none; }\n  @media (max-width: 800px) { .label { font-size:10px; padding:2px 5px; } #fs { width:20px; height:20px; } }\n</style>\n</head>\n<body>\n<div id=\"grid\"></div>\n<button id=\"fs\" title=\"Fullscreen\">⛶</button>\n<script>\nconst CAMS = [{\"title\": \"Philippines - El Nido\", \"url\": \"https://www.skylinewebcams.com/en/webcam/philippines/mimaropa/palawan/el-nido.html\"}, {\"title\": \"Agdao - Boy Sayong Store\", \"url\": \"https://www.skylinewebcams.com/en/webcam/philippines/davao/davao-del-sur/boy-sayong-store.html\"}, {\"title\": \"Davao - Barber Shop\", \"url\": \"https://www.skylinewebcams.com/en/webcam/philippines/davao/davao-del-sur/barber-shop.html\"}, {\"title\": \"Davao - Rosemary Street\", \"url\": \"https://www.skylinewebcams.com/en/webcam/philippines/davao/davao-del-sur/rosemary-street.html\"}, {\"title\": \"Tyre Repair Shop - Agdao\", \"url\": \"https://www.skylinewebcams.com/en/webcam/philippines/davao/davao-del-sur/tyre-repair-shop.html\"}, {\"title\": \"Davao - Soliman Crossing\", \"url\": \"https://www.skylinewebcams.com/en/webcam/philippines/davao/davao-del-sur/davao-city-soliman-crossing.html\"}, {\"title\": \"Benboy's Motor Bike Shop\", \"url\": \"https://www.skylinewebcams.com/en/webcam/philippines/davao/davao-del-sur/benboys-motor-bike-shop.html\"}, {\"title\": \"Davao City - Agdao\", \"url\": \"https://www.skylinewebcams.com/en/webcam/philippines/davao/davao-del-sur/davao-city-agdao.html\"}, {\"title\": \"Agdao Public Market - Stalls\", \"url\": \"https://www.skylinewebcams.com/en/webcam/philippines/davao/davao-del-sur/public-market.html\"}, {\"title\": \"Davao City - Philippines\", \"url\": \"https://www.skylinewebcams.com/en/webcam/philippines/davao/davao-del-sur/davao-city.html\"}, {\"title\": \"Shops of Agdao\", \"url\": \"https://www.skylinewebcams.com/en/webcam/philippines/davao/davao-del-sur/stores.html\"}, {\"title\": \"Lyn's Sisig Beef BBQ\", \"url\": \"https://www.skylinewebcams.com/en/webcam/philippines/davao/davao-del-sur/lyns-sisig-beef-bbq.html\"}, {\"title\": \"Lyn's Sisig Beef\", \"url\": \"https://www.skylinewebcams.com/en/webcam/philippines/davao/davao-del-sur/lyns-sisig-beef.html\"}, {\"title\": \"Davao - Roxas Avenue\", \"url\": \"https://www.skylinewebcams.com/en/webcam/philippines/davao/davao-del-sur/roxas-avenue.html\"}, {\"title\": \"Davao City - Market Area\", \"url\": \"https://www.skylinewebcams.com/en/webcam/philippines/davao/davao-del-sur/market-area.html\"}, {\"title\": \"Agdao Public Market - Wide\", \"url\": \"https://www.skylinewebcams.com/en/webcam/philippines/davao/davao-del-sur/davao-market.html\"}, {\"title\": \"Davao - Coreas Street\", \"url\": \"https://www.skylinewebcams.com/en/webcam/philippines/davao/davao-del-sur/coreas-street.html\"}, {\"title\": \"Davao City Streets\", \"url\": \"https://www.skylinewebcams.com/en/webcam/philippines/davao/davao-del-sur/davao.html\"}, {\"title\": \"Agdao - Wilfredo Aquino Street\", \"url\": \"https://www.skylinewebcams.com/en/webcam/philippines/davao/davao-del-sur/agdao-wilfredo-aquino-street.html\"}, {\"title\": \"Davao - Leon Garcia Street\", \"url\": \"https://www.skylinewebcams.com/en/webcam/philippines/davao/davao-del-sur/davao-city-leon-garcia-street.html\"}, {\"title\": \"Streets of Davao\", \"url\": \"https://www.skylinewebcams.com/en/webcam/philippines/davao/davao-del-sur/streets.html\"}, {\"title\": \"Bulusan Volcano\", \"url\": \"https://www.skylinewebcams.com/en/webcam/philippines/bicol/bulusan/bulusan-volcano.html\"}];\nconst grid = document.getElementById('grid');\nlet focused = null;\nfunction bestGrid(n, w, h) {\n  let best = {cols: Math.ceil(Math.sqrt(n)), rows: Math.ceil(n / Math.ceil(Math.sqrt(n))), score: -Infinity};\n  for (let cols = 1; cols <= n; cols++) {\n    const rows = Math.ceil(n / cols);\n    const tw = w / cols, th = h / rows;\n    const area = tw * th;\n    const ratio = tw / Math.max(1, th);\n    const ratioPenalty = Math.abs(Math.log(ratio / 1.65)) * 9000;\n    const emptyPenalty = (cols * rows - n) * 2500;\n    const score = area - ratioPenalty - emptyPenalty;\n    if (score > best.score) best = {cols, rows, score};\n  }\n  return best;\n}\nfunction layout() {\n  if (focused) return;\n  const g = bestGrid(CAMS.length, innerWidth || 1280, innerHeight || 720);\n  grid.style.setProperty('--cols', g.cols);\n  grid.style.setProperty('--rows', g.rows);\n}\nfunction build() {\n  grid.innerHTML = '';\n  CAMS.forEach((cam, i) => {\n    const tile = document.createElement('section');\n    tile.className = 'tile crop';\n    tile.title = cam.title;\n    const label = document.createElement('div');\n    label.className = 'label';\n    label.textContent = cam.title;\n    const wait = document.createElement('div');\n    wait.className = 'loading';\n    wait.textContent = 'Loading';\n    const frame = document.createElement('iframe');\n    frame.loading = 'eager';\n    frame.allow = 'autoplay; fullscreen; picture-in-picture; encrypted-media';\n    frame.referrerPolicy = 'strict-origin-when-cross-origin';\n    frame.setAttribute('allowfullscreen','');\n    frame.dataset.src = cam.url;\n    frame.onload = () => { wait.style.display = 'none'; };\n    tile.append(wait, frame, label);\n    tile.addEventListener('dblclick', () => toggleFocus(tile));\n    grid.appendChild(tile);\n  });\n  layout();\n  staggerLoad();\n}\nfunction staggerLoad() {\n  const frames = [...document.querySelectorAll('iframe[data-src]')];\n  frames.forEach((f, i) => setTimeout(() => { f.src = f.dataset.src; }, 180 * i));\n}\nfunction toggleFocus(tile) {\n  if (focused === tile) { tile.classList.remove('focus'); focused = null; layout(); return; }\n  if (focused) focused.classList.remove('focus');\n  focused = tile;\n  tile.classList.add('focus');\n}\ndocument.getElementById('fs').onclick = () => {\n  const el = document.documentElement;\n  if (!document.fullscreenElement) (el.requestFullscreen || el.webkitRequestFullscreen || el.msRequestFullscreen)?.call(el);\n  else (document.exitFullscreen || document.webkitExitFullscreen || document.msExitFullscreen)?.call(document);\n};\naddEventListener('resize', layout, {passive:true});\naddEventListener('keydown', e => {\n  if (e.key === 'Escape' && focused) toggleFocus(focused);\n  if (e.key.toLowerCase() === 'c') document.querySelectorAll('.tile').forEach(t => t.classList.toggle('crop'));\n  if (e.key.toLowerCase() === 'r') document.querySelectorAll('iframe').forEach(f => { const u=f.src; f.src='about:blank'; setTimeout(()=>f.src=u,250); });\n});\nbuild();\n</script>\n</body>\n</html>",
    "manifest.json": "{\n  \"name\": \"Philippines Skyline Webcam Wall\",\n  \"id\": \"philippines_skyline_webcam_wall_20260623\",\n  \"type\": \"app\",\n  \"category1\": \"Apps\",\n  \"category2\": \"Media\",\n  \"createdAt\": \"2026-06-23T07:36:32Z\",\n  \"source\": \"SkylineWebcams public Philippines webcam pages\",\n  \"cameraCount\": 22,\n  \"layout\": \"Zero-gap iframe grid with tiny translucent title overlays.\",\n  \"legal\": \"No video streams, tokens, or media assets are bundled. This app embeds public SkylineWebcams pages in iframes.\"\n}",
    "item.json": "{\n  \"id\": \"philippines_skyline_webcam_wall_20260623\",\n  \"type\": \"app\",\n  \"name\": \"Philippines Skyline Webcam Wall\",\n  \"category1\": \"Apps\",\n  \"category2\": \"Media\",\n  \"entryName\": \"Philippines Skyline Webcam Wall\",\n  \"icon\": \"<svg viewBox=\\\"0 0 64 64\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\"><defs><linearGradient id=\\\"g\\\" x1=\\\"0\\\" y1=\\\"0\\\" x2=\\\"1\\\" y2=\\\"1\\\"><stop stop-color=\\\"#0b1b2a\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#147a66\\\"/></linearGradient></defs><rect width=\\\"64\\\" height=\\\"64\\\" rx=\\\"14\\\" fill=\\\"url(#g)\\\"/><g fill=\\\"none\\\" stroke=\\\"#d8fff3\\\" stroke-width=\\\"3\\\"><rect x=\\\"10\\\" y=\\\"14\\\" width=\\\"19\\\" height=\\\"14\\\" rx=\\\"2\\\"/><rect x=\\\"35\\\" y=\\\"14\\\" width=\\\"19\\\" height=\\\"14\\\" rx=\\\"2\\\"/><rect x=\\\"10\\\" y=\\\"36\\\" width=\\\"19\\\" height=\\\"14\\\" rx=\\\"2\\\"/><rect x=\\\"35\\\" y=\\\"36\\\" width=\\\"19\\\" height=\\\"14\\\" rx=\\\"2\\\"/></g><circle cx=\\\"50\\\" cy=\\\"48\\\" r=\\\"5\\\" fill=\\\"#ffdf6e\\\"/></svg>\",\n  \"desktopIcon\": true,\n  \"preferredWidth\": 1420,\n  \"preferredHeight\": 900,\n  \"html\": \"\",\n  \"htmlSize\": 8525,\n  \"notes\": \"Tiled blind iframe wall for SkylineWebcams Philippines pages. Source HTML is stored only in files/index.html. Double-click a tile to focus/unfocus. Press C to toggle crop, R to reload frames.\",\n  \"parentId\": \"\",\n  \"editPrompt\": \"\",\n  \"version\": 1,\n  \"baseName\": \"Philippines Skyline Webcam Wall\",\n  \"createdAt\": \"2026-06-23T07:36:32Z\",\n  \"updatedAt\": \"2026-06-23T07:36:32Z\"\n}",
    "readme.txt": "Philippines Skyline Webcam Wall\n\nSingle VAiOS app: tiled Philippines SkylineWebcams wall.\n\nBehavior:\n- Zero-gap iframe grid.\n- Tiny translucent overlay title on each tile.\n- Tiny fullscreen button in top-right corner.\n- Uses SkylineWebcams public webcam pages as iframe sources.\n- No extracted stream URLs, no HLS tokens, no bundled media assets.\n- Double-click a tile to focus/unfocus.\n- Press C to toggle crop mode if a page layout changes.\n- Press R to reload all frames.\n\nCamera count: 22\n\nPackage rule:\n- files/index.html contains the app source.\n- item.html is blank.\n- Large HTML is not duplicated.\n",
    "cams.json": "[\n  {\n    \"title\": \"Philippines - El Nido\",\n    \"url\": \"https://www.skylinewebcams.com/en/webcam/philippines/mimaropa/palawan/el-nido.html\"\n  },\n  {\n    \"title\": \"Agdao - Boy Sayong Store\",\n    \"url\": \"https://www.skylinewebcams.com/en/webcam/philippines/davao/davao-del-sur/boy-sayong-store.html\"\n  },\n  {\n    \"title\": \"Davao - Barber Shop\",\n    \"url\": \"https://www.skylinewebcams.com/en/webcam/philippines/davao/davao-del-sur/barber-shop.html\"\n  },\n  {\n    \"title\": \"Davao - Rosemary Street\",\n    \"url\": \"https://www.skylinewebcams.com/en/webcam/philippines/davao/davao-del-sur/rosemary-street.html\"\n  },\n  {\n    \"title\": \"Tyre Repair Shop - Agdao\",\n    \"url\": \"https://www.skylinewebcams.com/en/webcam/philippines/davao/davao-del-sur/tyre-repair-shop.html\"\n  },\n  {\n    \"title\": \"Davao - Soliman Crossing\",\n    \"url\": \"https://www.skylinewebcams.com/en/webcam/philippines/davao/davao-del-sur/davao-city-soliman-crossing.html\"\n  },\n  {\n    \"title\": \"Benboy's Motor Bike Shop\",\n    \"url\": \"https://www.skylinewebcams.com/en/webcam/philippines/davao/davao-del-sur/benboys-motor-bike-shop.html\"\n  },\n  {\n    \"title\": \"Davao City - Agdao\",\n    \"url\": \"https://www.skylinewebcams.com/en/webcam/philippines/davao/davao-del-sur/davao-city-agdao.html\"\n  },\n  {\n    \"title\": \"Agdao Public Market - Stalls\",\n    \"url\": \"https://www.skylinewebcams.com/en/webcam/philippines/davao/davao-del-sur/public-market.html\"\n  },\n  {\n    \"title\": \"Davao City - Philippines\",\n    \"url\": \"https://www.skylinewebcams.com/en/webcam/philippines/davao/davao-del-sur/davao-city.html\"\n  },\n  {\n    \"title\": \"Shops of Agdao\",\n    \"url\": \"https://www.skylinewebcams.com/en/webcam/philippines/davao/davao-del-sur/stores.html\"\n  },\n  {\n    \"title\": \"Lyn's Sisig Beef BBQ\",\n    \"url\": \"https://www.skylinewebcams.com/en/webcam/philippines/davao/davao-del-sur/lyns-sisig-beef-bbq.html\"\n  },\n  {\n    \"title\": \"Lyn's Sisig Beef\",\n    \"url\": \"https://www.skylinewebcams.com/en/webcam/philippines/davao/davao-del-sur/lyns-sisig-beef.html\"\n  },\n  {\n    \"title\": \"Davao - Roxas Avenue\",\n    \"url\": \"https://www.skylinewebcams.com/en/webcam/philippines/davao/davao-del-sur/roxas-avenue.html\"\n  },\n  {\n    \"title\": \"Davao City - Market Area\",\n    \"url\": \"https://www.skylinewebcams.com/en/webcam/philippines/davao/davao-del-sur/market-area.html\"\n  },\n  {\n    \"title\": \"Agdao Public Market - Wide\",\n    \"url\": \"https://www.skylinewebcams.com/en/webcam/philippines/davao/davao-del-sur/davao-market.html\"\n  },\n  {\n    \"title\": \"Davao - Coreas Street\",\n    \"url\": \"https://www.skylinewebcams.com/en/webcam/philippines/davao/davao-del-sur/coreas-street.html\"\n  },\n  {\n    \"title\": \"Davao City Streets\",\n    \"url\": \"https://www.skylinewebcams.com/en/webcam/philippines/davao/davao-del-sur/davao.html\"\n  },\n  {\n    \"title\": \"Agdao - Wilfredo Aquino Street\",\n    \"url\": \"https://www.skylinewebcams.com/en/webcam/philippines/davao/davao-del-sur/agdao-wilfredo-aquino-street.html\"\n  },\n  {\n    \"title\": \"Davao - Leon Garcia Street\",\n    \"url\": \"https://www.skylinewebcams.com/en/webcam/philippines/davao/davao-del-sur/davao-city-leon-garcia-street.html\"\n  },\n  {\n    \"title\": \"Streets of Davao\",\n    \"url\": \"https://www.skylinewebcams.com/en/webcam/philippines/davao/davao-del-sur/streets.html\"\n  },\n  {\n    \"title\": \"Bulusan Volcano\",\n    \"url\": \"https://www.skylinewebcams.com/en/webcam/philippines/bicol/bulusan/bulusan-volcano.html\"\n  }\n]"
